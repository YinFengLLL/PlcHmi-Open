# ── 编译产物 ──────────────────────────────────────────────
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# ── 发布产物（dist 是正式发布目录，文件大且可重建）────────
dist/
publish/

# ── 运行日志 ──────────────────────────────────────────────
logs/
**/logs/

# ── 运行期数据（报警历史等：属于现场数据，不属于源码）──────
data/
**/data/

# ── 打包中间产物（zip 可从源码重建）──────────────────────
upload/
upload-tmp/
*.zip

# ── 原子写产生的临时与回滚文件 ────────────────────────────
*.tmp
*.bak

# ── 操作系统 ──────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ── AI 助手本地数据（不属于项目源码）──
.codebuddy/
.workbuddy/
__pycache__/

# ── 本地备份 / 第三方 SDK / 旧发布包（不属于源码，2026-11-13 推送前排除）──
.backup/
VMsdk/
*.rar
