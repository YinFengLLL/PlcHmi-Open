<Application x:Class="上位机.应用.应用"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:上位机.应用.视图模型"
             xmlns:views="clr-namespace:上位机.应用.视图">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 合并顺序即依赖顺序：Base（主题无关令牌）→ 主题调色板 → Controls（控件）
                     → Icons（图标）→ Motion（动效）。Controls 早于 Icons 合并是有意为之：
                     控件字典里若 BasedOn 图标样式，加载时会找不到资源而直接抛异常。

                     双主题：Palette.Dark.xaml 与 Palette.Light.xaml 键集合一致，
                     运行期由 主题管理器（Services/ThemeManager.cs）整体替换这一份字典
                     完成深浅切换；默认深色。颜色类令牌必须 DynamicResource 引用。 -->
                <ResourceDictionary Source="Themes/Palette.Base.xaml" />
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Images/PlcHmi.Icons.xaml" />
                <ResourceDictionary Source="Themes/Motion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══ 页面 ViewModel → View 映射 ════════════════════════════
                 内容区用 ContentControl 呈现 CurrentPage，
                 WPF 依据运行时类型自动挑选对应模板，导航代码无需引用任何 View。 -->

            <DataTemplate DataType="{x:Type vm:运行视图模型}">
                <views:运行视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:参数视图模型}">
                <views:参数视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:锁附示教视图模型}">
                <views:锁附示教视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:点胶示教视图模型}">
                <views:点胶示教视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:标定视图模型}">
                <views:标定视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:配方视图模型}">
                <views:配方视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:手动视图模型}">
                <views:手动视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:IO视图模型}">
                <views:IO视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:报警视图模型}">
                <views:报警视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:历史记录视图模型}">
                <views:历史记录视图 />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:设置视图模型}">
                <views:设置视图 />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
