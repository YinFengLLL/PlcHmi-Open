<UserControl x:Class="上位机.应用.视图.配方视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:上位机.应用.转换器"
             xmlns:vm="clr-namespace:上位机.应用.视图模型"
             d:DataContext="{d:DesignInstance Type=vm:配方视图模型}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:布尔可见性转换器 x:Key="BoolToVis" />

        <!-- 机种列表行 -->
        <DataTemplate x:Key="RecipeRowTemplate" DataType="{x:Type vm:配方行视图模型}">
            <Border x:Name="行根元素" Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <!-- 行高 48：容纳 44px 的「切换」按钮，触屏不误触相邻行 -->
                <Grid Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="行号" Grid.Column="0" Text="{Binding 号, StringFormat={}{0:00}}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="13" Margin="{StaticResource GapLeft16}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="行名称" Grid.Column="1" Text="{Binding 显示名称}"
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="行数据量" Grid.Column="2" Text="{Binding 数据摘要}"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <TextBlock x:Name="行区段" Grid.Column="3" Text="D2500–3999"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ToolTip="该机种保存的是 D2500–D3999 区段快照（含点胶结构体参数与标定）" />

                    <!-- 切换机种是影响生产的关键写操作：44px 触控目标（确认框在 VM 层兜底） -->
                    <Button Grid.Column="4" Content="切换"
                            Style="{StaticResource SecondaryButton}"
                            Width="92" Height="44" Margin="{StaticResource GapRight16}"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.异步切换配方Command,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- 当前机种行高亮，并把「切换」换成「当前」 -->
                <DataTrigger Binding="{Binding 是否当前}" Value="True">
                    <Setter TargetName="行根元素" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                    <Setter TargetName="行号" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter TargetName="行号" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="行名称" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter TargetName="行名称" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>

                <!-- 未录入数据的机种置灰 -->
                <DataTrigger Binding="{Binding 有数据}" Value="False">
                    <Setter TargetName="行数据量" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                    <Setter TargetName="行区段" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}"
          Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <TextBlock Text="{Binding 标题}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding 副标题}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <!-- 当前机种：机种号 + 名称 + 保存合并为一张卡（原先两张卡并排，信息被割裂） -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="{StaticResource GapBottom12}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource GapRight20}">
                    <TextBlock Text="当前机种号" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding 当前号, StringFormat={}{0:00}}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                               Margin="{StaticResource GapTop4}" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}"
                        Margin="{StaticResource GapRight20}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="机种名（可编辑，保存在上位机本地）"
                               Style="{StaticResource CaptionText}" Margin="{StaticResource GapBottom8}" />
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding 当前名称, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="24" MinWidth="220"
                             HorizontalAlignment="Left" />
                </StackPanel>

                <Button Grid.Column="3" Content="保存名称"
                        Style="{StaticResource SecondaryButton}"
                        Width="110" VerticalAlignment="Bottom"
                        Command="{Binding 异步保存名称Command}" />
            </Grid>
        </Border>

        <!-- 启动一致性校验结果 -->
        <Border Grid.Row="2" Padding="{StaticResource ToolBarPadding}" Margin="{StaticResource GapBottom12}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding 有一致性问题}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Margin="{StaticResource GapRight12}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding 有一致性问题}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1" Text="{Binding 一致性文本}"
                           Style="{StaticResource BodyText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 机种数据（D2500–3999）：读 PLC 存成机种 / 把机种写进 PLC。
                         这两颗按钮是现场示教→保存→换机种的主路径。 -->
                    <Button Content="保存机种"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" Margin="{StaticResource GapRight8}"
                            ToolTip="把 PLC 当前 D2500–D3999 的数据读回来，存成当前机种（不写 PLC）"
                            Command="{Binding 异步保存机种Command}" />

                    <Button Content="下发机种"
                            Style="{StaticResource SecondaryButton}"
                            Height="44" Margin="{StaticResource GapRight16}"
                            ToolTip="把当前机种的快照整段写入 PLC 的 D2500–D3999"
                            Command="{Binding 异步下发机种Command}" />

                    <!-- 全局参数（机种区段之外，不随机种变动）：「从 PLC 读取」常驻可用（低风险，只改本地）；
                         「下发全局参数」是覆盖 PLC 参数区的写操作（Warning 级确认），两者不等权 -->
                    <Button Content="从 PLC 读取参数"
                            Style="{StaticResource SecondaryButton}"
                            Height="44" Margin="{StaticResource GapRight8}"
                            ToolTip="读取 PLC 参数区当前值并覆盖本地全局参数（不写 PLC）；PLC 值超范围将被整体拒绝"
                            Command="{Binding 异步从PLC拉取Command}" />

                    <!-- 常驻可用：把上位机当前的全局参数写进 PLC（Warning 级确认在 VM 层） -->
                    <Button Content="下发全局参数"
                            Style="{StaticResource SecondaryButton}"
                            Height="44"
                            ToolTip="把上位机当前的全局参数写入 PLC 参数区"
                            Command="{Binding 异步推送到PLCCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 机种列表 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Background="{DynamicResource PrimarySoftBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="机种号" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource ToolBarPadding}" />
                    <TextBlock Grid.Column="1" Text="机种名" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource GapV12}" />
                    <TextBlock Grid.Column="2" Text="数据量" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{StaticResource GapV12}"
                               ToolTip="该机种已保存的 D2500–D3999 非 0 寄存器项数" />
                    <TextBlock Grid.Column="3" Text="机种区段" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{StaticResource GapV12}" />
                    <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="{StaticResource GapV12}" />
                </Grid>

                <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding 配方集合}"
                                      ItemTemplate="{StaticResource RecipeRowTemplate}" />
                        <!-- 空状态：机种列表为空时给出引导，而不是一片空白 -->
                        <TextBlock Text="还没有任何机种数据，请先在 PLC 侧完成参数设置后「从 PLC 读取参数」，或「导入 CSV」。"
                                   HorizontalAlignment="Center" Margin="{StaticResource GapTop60}"
                                   TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding 配方集合.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="4" Margin="{StaticResource GapTop16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="机种主存于 config/recipes.json；CSV 仅作交换格式，改完需「导入 CSV」再「下发到 PLC」才生效。"
                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="{StaticResource GapRight12}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="刷新列表" Style="{StaticResource SecondaryButton}" Width="100"
                        Margin="{StaticResource GapRight12}" Command="{Binding 刷新Command}" />
                <Button Content="导出 CSV" Style="{StaticResource SecondaryButton}" Width="110"
                        Margin="{StaticResource GapRight12}" ToolTip="把当前机种导出为 CSV，可用 Excel 编辑"
                        Command="{Binding 异步导出CSVCommand}" />
                <Button Content="批量导出" Style="{StaticResource SecondaryButton}" Width="110"
                        Margin="{StaticResource GapRight12}" ToolTip="把全部机种导出到一个目录，每个机种一个 CSV"
                        Command="{Binding 异步导出全部CSVCommand}" />
                <Button Content="导入 CSV" Style="{StaticResource PrimaryButton}" Width="120"
                        ToolTip="从 CSV 导入机种配方（只更新本机数据，不写 PLC）"
                        Command="{Binding 异步导入CSVCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
