<UserControl x:Class="上位机.应用.视图.报警视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:上位机.应用.转换器"
             xmlns:vm="clr-namespace:上位机.应用.视图模型"
             d:DataContext="{d:DesignInstance Type=vm:报警视图模型}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:布尔可见性转换器 x:Key="BoolToVis" />
        <conv:资源键画刷转换器 x:Key="KeyToBrush" />
        <conv:等级背景转换器 x:Key="LevelToBg" />

        <!-- 报警行模板 -->
        <DataTemplate x:Key="AlarmRowTemplate" DataType="{x:Type vm:报警条目视图模型}">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <!-- 等级标签 -->
                    <Border Grid.Column="0" Style="{StaticResource Badge}" Margin="{StaticResource GapLeft12}"
                            Background="{Binding 等级背景键, Converter={StaticResource LevelToBg}}">
                        <TextBlock Text="{Binding 等级文本}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding 等级颜色键, Converter={StaticResource KeyToBrush}}" />
                    </Border>

                    <!-- 代码 -->
                    <TextBlock Grid.Column="1" Text="{Binding 代码}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryLightBrush}" />

                    <!-- 描述：报警信息永不截断——换行显示，操作员必须能看到完整文本 -->
                    <TextBlock Grid.Column="2" Text="{Binding 消息}"
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="{StaticResource GapV12}" />

                    <!-- 触发时间 -->
                    <TextBlock Grid.Column="3" Text="{Binding 时间文本}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <!-- 消除时间 -->
                    <TextBlock Grid.Column="4" Text="{Binding 已清除文本}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <!-- 确认按钮：44px 触控基准 -->
                    <Button Grid.Column="5" Content="确认"
                            Height="44" Width="84" Margin="{StaticResource ToolBarButtonMargin}"
                            ToolTip="确认这条报警"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.确认Command,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding 是否已确认}" Value="True">
                                        <Setter Property="Content" Value="已确认" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}"
          Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <TextBlock Text="{Binding 标题}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding 副标题}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="{StaticResource ToolBarPadding}" Margin="{StaticResource GapBottom16}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="活动报警"
                            Height="44" Padding="18,0"
                            Margin="{StaticResource GapRight8}"
                            Command="{Binding 显示活动Command}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding 显示历史}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="历史记录"
                            Height="44" Padding="18,0"
                            Command="{Binding 显示历史列表Command}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding 显示历史}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="4"
                            Padding="{StaticResource ChipPadding}" Margin="{StaticResource GapLeft16}" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding 活动数量}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- 活动计数是本页最需要被看见的数字：16px 加重 -->
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}">
                            <Run Text="活动 " />
                            <Run Text="{Binding 活动数量, Mode=OneWay}" />
                            <Run Text=" 条" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- 按危险等级排布：全部确认（批量，Neutral）→ 报警复位（写 PLC，Warning）→
                         清除历史（不可恢复，Dangerous 独立样式 + 拉开间距）；颜色一律取自组件库 -->
                    <Button Content="全部确认" Style="{StaticResource SecondaryButton}"
                            Height="44" Margin="{StaticResource GapRight8}"
                            Command="{Binding 确认全部Command}" />
                    <Button Content="报警复位" Style="{StaticResource ButtonWarning}"
                            Height="44" Margin="{StaticResource GapRight8}"
                            Command="{Binding 异步重置Command}" />
                    <Button Content="清除历史" Style="{StaticResource DangerousActionButton}"
                            Height="44" Margin="{StaticResource GapLeft16}"
                            Command="{Binding 清空历史Command}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <!-- 表头 -->
                <Grid DockPanel.Dock="Top" Background="{DynamicResource PrimarySoftBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="等级" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource ToolBarPadding}" />
                    <TextBlock Grid.Column="1" Text="代码" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource GapV12}" />
                    <TextBlock Grid.Column="2" Text="报警描述" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource GapV12}" />
                    <TextBlock Grid.Column="3" Text="触发时间" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource GapV12}" />
                    <TextBlock Grid.Column="4" Text="消除时间" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource GapV12}" />
                    <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource ToolBarPadding}" />
                </Grid>

                <!-- 两个滚动区叠放于同一层 Grid 内：任一时刻只有一个是可见的
                     （活动 / 历史由 显示历史 切换），所以叠放没有命中冲突。

                     必须共用一层，不能并列放进 DockPanel：DockPanel 里没写 Dock 的
                     子元素按默认 Dock="Left" 停靠，宽度会缩到"期望宽度"。列表为空时
                     期望宽度就等于空状态那一小块 —— 结果是空状态居中变成贴左、
                     有数据时数据行也可能与表头对不齐。
                     HorizontalContentAlignment 同理要给 Stretch（ScrollViewer 默认 Left）。 -->
                <Grid>
                    <!-- 活动报警 -->
                    <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding 显示历史, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding 活动报警}"
                                          ItemTemplate="{StaticResource AlarmRowTemplate}" />
                            <!-- 空状态：「无活动报警」是设备正常时的**常态**，操作员每天
                                 都要看它几十次。一行灰字会让人反复确认"是不是坏了/没连上"，
                                 加一个置灰图标就明确回答"对，就是没有"。 -->
                            <StackPanel HorizontalAlignment="Center" Margin="{StaticResource GapTop60}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding 活动报警.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Style="{StaticResource IconPathLarge}"
                                      Data="{StaticResource Icon.Status.Alarm}"
                                      Stroke="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Text="当前无活动报警" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                           Margin="{StaticResource GapTop8}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 历史记录 -->
                    <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding 显示历史, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding 历史}"
                                          ItemTemplate="{StaticResource AlarmRowTemplate}" />
                            <!-- 历史空状态：与活动报警同款模式（同一套视觉语言，不要在这里
                                 再发明第二种空状态样式） -->
                            <StackPanel HorizontalAlignment="Center" Margin="{StaticResource GapTop60}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding 历史.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Style="{StaticResource IconPathLarge}"
                                      Data="{StaticResource Icon.Status.Alarm}"
                                      Stroke="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Text="暂无历史报警记录" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                           Margin="{StaticResource GapTop8}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ══ 报警配置（仅管理员可见）══════════════════════════════════ -->
        <!-- 把 PLC 的 D550–D554 位、M500–M600 映射成报警文本 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="{StaticResource GapTop16}"
                Visibility="{Binding 可编辑报警, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="{StaticResource GapBottom12}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="报警配置（管理员）" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding 定义摘要}"
                                   Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="+ 新增报警"
                            Style="{StaticResource SecondaryButton}"
                            Height="44" VerticalAlignment="Top"
                            ToolTip="新增一条报警并绑定 PLC 地址"
                            Command="{Binding 异步添加报警Command}" />
                </Grid>

                <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" MaxHeight="240">
                    <ItemsControl ItemsSource="{Binding 定义集合}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="{StaticResource ListRowPadding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding 标识}"
                                                   FontFamily="{StaticResource NumericFontFamily}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                        <TextBlock Grid.Column="1" Text="{Binding 地址文本}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource NumericFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   ToolTip="{Binding 位文本}" />

                                        <TextBlock Grid.Column="2" Text="{Binding 消息}"
                                                   Style="{StaticResource BodyText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding 建议}" />

                                        <!-- 启用状态：点一下即切换 -->
                                        <Button Grid.Column="3" Width="72" Height="44" Margin="{StaticResource GapRight12}"
                                                VerticalAlignment="Center"
                                                ToolTip="点击启用 / 停用这条报警"
                                                Command="{Binding DataContext.异步切换报警Command,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                    <Setter Property="Content" Value="已停用" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding 启用}" Value="True">
                                                            <Setter Property="Content" Value="已启用" />
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="✎" FontSize="16" ToolTip="编辑报警文本与地址"
                                                    Style="{StaticResource IconButton}" Margin="{StaticResource GapRight8}"
                                                    Command="{Binding DataContext.异步编辑报警Command,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" FontSize="16" ToolTip="删除这条报警"
                                                    Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.异步移除报警Command,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
