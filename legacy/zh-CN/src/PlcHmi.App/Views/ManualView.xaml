<UserControl x:Class="上位机.应用.视图.手动视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:上位机.应用.转换器"
             xmlns:vm="clr-namespace:上位机.应用.视图模型"
             d:DataContext="{d:DesignInstance Type=vm:手动视图模型}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:布尔可见性转换器 x:Key="BoolToVis" />
        <conv:布尔状态画刷转换器 x:Key="BoolToStatus" />

        <!-- 手动页元件（气缸 / 按钮 / 指示灯） -->
        <DataTemplate x:Key="WidgetTemplate" DataType="{x:Type vm:手动元件视图模型}">
            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{StaticResource WidgetCardPadding}" Margin="{StaticResource GapBottom12}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                 Fill="{Binding 是否活动, Converter={StaticResource BoolToStatus}}"
                                 Margin="{StaticResource GapRight12}" />
                        <StackPanel>
                            <TextBlock Text="{Binding 名称}" Style="{StaticResource BodyText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}">
                                <Run Text="{Binding 状态文本, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding 地址文本, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- 主操作：单线圈切换按钮——置位=伸出、复位=缩回，按钮文案显示“将要执行的动作”。
                         刻意不做伸出/缩回双按钮：一个线圈一个开关，双按钮是冗余（需求方 2026-09-11）。
                         全页最高频操作：96×52 触控目标，高于 44 基准。 -->
                    <Button Grid.Column="1" Content="{Binding 动作文本}"
                            Command="{Binding DataContext.异步切换元件Command,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                <Setter Property="Width" Value="96" />
                                <Setter Property="Height" Value="52" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding 是否指示灯}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 元件的编辑 / 删除：仅管理员可见。44×44 触控基准（IconButton） -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Visibility="{Binding DataContext.可编辑元件,
                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                     Converter={StaticResource BoolToVis}}">
                        <Button Content="✎" FontSize="16" ToolTip="编辑名称与绑定地址"
                                Style="{StaticResource IconButton}" Margin="{StaticResource GapRight8}"
                                Command="{Binding DataContext.异步编辑元件Command,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="✕" FontSize="16" ToolTip="删除元件"
                                Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.异步移除元件Command,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 轴选择按钮 -->
        <DataTemplate x:Key="AxisTemplate" DataType="{x:Type vm:轴视图模型}">
            <Button Height="52" Margin="{StaticResource GapRight8}" Padding="0" Cursor="Hand"
                    Command="{Binding DataContext.选择轴Command,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="根元素"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="轴名称文本" Text="{Binding 名称}"
                                           FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="轴位置文本" Text="{Binding 位置文本}"
                                           FontFamily="{StaticResource NumericFontFamily}"
                                           FontSize="13" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="根元素" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding 是否选中}" Value="True">
                                <Setter TargetName="根元素" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="根元素" Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}" />
                                <Setter TargetName="轴名称文本" Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
                                <Setter TargetName="轴位置文本" Property="Foreground" Value="{DynamicResource OnPrimaryFadedTextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}"
          Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 手动使能开关 -->
        <Grid Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding 标题}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding 副标题}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
            </StackPanel>

            <Border Grid.Column="1" Padding="{StaticResource ToolBarPadding}" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="手动使能" Style="{StaticResource BodyText}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="{StaticResource GapRight16}" />
                    <CheckBox IsChecked="{Binding 是否手动启用}"
                              VerticalAlignment="Center"
                              ToolTip="开启后方可执行气缸与点动操作" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 未使能提示 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="{StaticResource ToolBarPadding}" Margin="{StaticResource GapBottom16}"
                Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                Visibility="{Binding 是否手动启用, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource WarningBrush}"
                         Margin="{StaticResource GapRight12}" />
                <TextBlock Text="手动操作已锁定，请先开启右上角的「手动使能」再进行调试动作。"
                           Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 双栏：气缸 / 轴点动 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- 手动元件（配置驱动） -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="{StaticResource GapRight8}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="{StaticResource GapBottom16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="手动元件" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="元件定义来自 config/manual-widgets.json，绑定 M 区"
                                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
                        </StackPanel>

                        <!-- 新增元件：仅管理员可见 -->
                        <Button Grid.Column="1" Content="+ 新增元件"
                                Style="{StaticResource SecondaryButton}"
                                Height="44" VerticalAlignment="Top"
                                ToolTip="新增一个手动页元件并绑定 M 区地址"
                                Visibility="{Binding 可编辑元件, Converter={StaticResource BoolToVis}}"
                                Command="{Binding 异步添加元件Command}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding 元件集合}"
                                          ItemTemplate="{StaticResource WidgetTemplate}" />

                            <!-- 空列表提示：图标 + 文案，与报警页 / IO 页同一套
                                 空状态语言（置灰大图标 + 一行说明） -->
                            <StackPanel Margin="{StaticResource GapTop20}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding 有元件}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Style="{StaticResource IconPathLarge}"
                                      Data="{StaticResource Icon.Device.Cylinder}"
                                      Stroke="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Text="还没有配置任何手动元件。管理员可点右上角「+ 新增元件」。"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Style="{StaticResource CaptionText}"
                                           Margin="{StaticResource GapTop8}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 轴点动 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="{StaticResource GapLeft8}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource GapBottom16}">
                        <TextBlock Text="轴点动 JOG" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="选择轴后按住方向键点动" Style="{StaticResource CaptionText}"
                                   Margin="{StaticResource GapTop4}" />
                    </StackPanel>

                    <StackPanel>
                        <!-- 轴选择 -->
                        <ItemsControl ItemsSource="{Binding 轴列表}"
                                      ItemTemplate="{StaticResource AxisTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 六轴：一行放不下，用 WrapPanel 自动换行 -->
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 当前位置 -->
                        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6"
                                Padding="{StaticResource ToolBarPadding}" Margin="{StaticResource GapTop16}">
                            <Grid>
                                <TextBlock Text="当前位置" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding 当前位置文本}"
                                           FontFamily="{StaticResource NumericFontFamily}"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 点动速度档位：写入当前轴对应的档位寄存器（1 低 / 2 中 / 3 高），随轴切换。
                             档位是"上位机最近一次写入"的记忆，不是 PLC 实时回读
                             （与气缸、参数页按钮表同一约定）。 -->
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource GapTop16}">
                            <TextBlock Text="点动速度" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" Margin="{StaticResource GapRight12}" />
                            <!-- 档位写入值口径（2026-10-13）：低=0、中=1、高=2 -->
                            <Button Content="低速" Width="76" Margin="{StaticResource GapRight8}"
                                    Style="{StaticResource JogLevelLowButton}"
                                    Command="{Binding 异步设置点动速度Command}" CommandParameter="0" />
                            <Button Content="中速" Width="76" Margin="{StaticResource GapRight8}"
                                    Style="{StaticResource JogLevelMediumButton}"
                                    Command="{Binding 异步设置点动速度Command}" CommandParameter="1" />
                            <Button Content="高速" Width="76"
                                    Style="{StaticResource JogLevelHighButton}"
                                    Command="{Binding 异步设置点动速度Command}" CommandParameter="2" />
                            <TextBlock Text="档位为最近一次写入的记忆，非实时回读"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                       Margin="{StaticResource GapLeft12}" />
                        </StackPanel>

                        <!-- 方向按钮：按住才动、松开即停。
                             没有独立「停止」按钮——松开即停，且拖出按钮/拖出窗口/窗口失焦都会兜底停止
                             （JogGesture 负责，接线在 ManualView.xaml.cs）。
                             "松开即停"提示全页只保留底部说明一处，不再用 ToolTip 重复。 -->
                        <UniformGrid Rows="1" Columns="2" Margin="{StaticResource GapTop12}">
                            <Button x:Name="点动反转按钮" Content="◀ 负向"
                                    Style="{StaticResource ButtonNeutral}"
                                    Margin="{StaticResource GapRight12}" />
                            <Button x:Name="点动正转按钮" Content="正向 ▶"
                                    Style="{StaticResource ButtonNeutral}" />
                        </UniformGrid>

                        <TextBlock Text="按住方向按钮点动，松开立即停止（拖出按钮或切换窗口同样会停止）"
                                   Style="{StaticResource CaptionText}"
                                   Margin="{StaticResource GapTop8}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
