<UserControl x:Class="上位机.应用.视图.示教状态灯"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
             xmlns:conv="clr-namespace:上位机.应用.转换器"
             xmlns:views="clr-namespace:上位机.应用.视图">
    <!--
        示教页顶部固定状态灯（锁附示教 / 点胶示教共用一份定义 → 两页显示必然一致）。

        绑定直接取页面的 DataContext（两个示教页 VM 的属性同名，见 PointTableTeachViewModel.Lamp.cs）：
          回原灯可见 / 回原闪烁 / 回原状态文本 / 回原状态颜色键 / 回原地址提示

        为什么整块（灯芯 + 文字）一起闪：现场要"一眼看到没回原"，只闪 8px 的灯芯太弱；
        文字短、闪烁幅度 1→0.3 仍可读，且文字本身也说明了状态（颜色不单独承载信息）。

        系统关掉动效时（ClientAreaAnimation=False）不启动动画，退化为常亮——
        与顶栏报警图标、连接指示点同一套做法。
    -->
    <UserControl.Resources>
        <conv:布尔可见性转换器 x:Key="BoolToVis" />
        <conv:资源键画刷转换器 x:Key="KeyToBrush" />
    </UserControl.Resources>

    <Border Padding="12,6" CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            Visibility="{Binding 回原灯可见, Converter={StaticResource BoolToVis}}"
            ToolTip="{Binding 回原地址提示}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding 回原闪烁}" Value="True" />
                                <!-- 加载时求值一次；系统动效设置中途修改不重估，可接受 -->
                                <Condition Binding="{Binding Source={x:Static sys:SystemParameters.ClientAreaAnimation}}"
                                           Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.3" Duration="0:0:0.55"
                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <views:辉光状态灯 Fill="{Binding 回原状态颜色键, Converter={StaticResource KeyToBrush}}"
                              Width="16" Height="16"
                              VerticalAlignment="Center"
                              Margin="{StaticResource GapRight8}" />

            <TextBlock Text="{Binding 回原状态文本}"
                       Style="{StaticResource BodyText}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
