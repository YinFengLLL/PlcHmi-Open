<Window x:Class="上位机.应用.主窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:上位机.应用.转换器"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:上位机.应用.视图模型"
        xmlns:views="clr-namespace:上位机.应用.视图"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:主视图模型}"
        Title="工控上位机 · PlcHmi"
        Height="1080" Width="1920"
        MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <!-- ══ 自绘标题栏（v2）════════════════════════════════════════════
         WindowStyle="None" + WindowChrome 取代系统标题栏。
         CaptionHeight=62 与顶栏行高一致 → 顶栏空白处可直接拖窗。

         坑点备忘（结论与初稿方案不同，记录在此以免后来人重走一遍）：
         "WindowStyle=None 最大化会盖住任务栏"这个经典坑，只发生在**没有
         WindowChrome**、或 AllowsTransparency=True 的组合下。挂了 WindowChrome
         之后 WPF 的 WindowChromeWorker 自己会处理 WM_GETMINMAXINFO，并按
         ResizeBorderThickness 留出贴边缩放的余量。
         因此这里**刻意不写**自定义的 WM_GETMINMAXINFO 钩子 —— 加了反而可能
         与 WPF 的处理叠加，多扣一次边框，最大化后四周留缝。

         ResizeBorderThickness=6 是"贴边可缩放"的手感来源：太小会点不中，
         太大则与内容区的边缘控件抢命中区域。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="62"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:资源键画刷转换器 x:Key="KeyToBrush" />
        <conv:资源键几何转换器 x:Key="KeyToGeometry" />
        <conv:布尔可见性转换器 x:Key="BoolToVisibility" />
        <conv:侧栏宽度转换器 x:Key="SidebarWidth" />

        <!-- 导航图标：未选中弱一档（次要色），选中点亮主蓝亮。
             BasedOn IconPath 写在窗口资源里是刻意的——
             窗口加载时 App 资源已全部合并；若放 Controls.xaml 则依赖字典合并顺序，脆弱 -->
        <Style x:Key="NavItemIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="{StaticResource GapRight8}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                             Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource PrimaryLightBrush}" />
                </DataTrigger>
                <!-- 侧栏收起（64px 纯图标栏）：去掉图标右侧间距，让图标居中 -->
                <DataTrigger Binding="{Binding DataContext.侧栏已收起, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 底栏报警图标：危险级(红)时闪烁；尊重系统"减少动效"设置
             （ClientAreaAnimation=False 时不启动动画，静态常亮） -->
        <Style x:Key="AlarmBarIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding 报警栏颜色键}" Value="DangerBrush" />
                        <!-- 加载时求值一次；系统动效设置中途修改不重估，可接受 -->
                        <Condition Binding="{Binding Source={x:Static sys:SystemParameters.ClientAreaAnimation}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.25" Duration="0:0:0.6"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 连接指示点（辉光版）：通信正常时缓慢呼吸。
             这是"心跳"不是"警报"——幅度 1→0.35 / 0.9s 往返，刻意比报警闪烁
             慢一倍、浅一倍，不能和报警抢注意力。离线时常亮，不假装还活着。
             系统关掉动效时同样退化为常亮。 -->
        <Style x:Key="ConnectionGlowDot" TargetType="views:辉光状态灯">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource GapRight8}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding 连接状态颜色键}" Value="SuccessBrush" />
                        <Condition Binding="{Binding Source={x:Static sys:SystemParameters.ClientAreaAnimation}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.9"
                                                 AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 窗口控制键字形：尺寸固定 12×12，坐标手绘，不用字体图标
             （字体图标在精简版系统镜像上会退化成方块，见 docs/06 §1.3） -->
        <Style x:Key="WindowGlyph" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- 导航项：图标 + 标题（侧栏收起时只留图标并居中，名称走 ToolTip） -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:导航条目}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.侧栏已收起, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="{Binding 图标键, Converter={StaticResource KeyToGeometry}}"
                      Style="{StaticResource NavItemIcon}" />
                <TextBlock Text="{Binding 标题}" Style="{StaticResource NavItemText}"
                           VerticalAlignment="Center"
                           Visibility="{Binding DataContext.侧栏已收起, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- 根容器：最大化时整体内收系统边框量（见代码后置 应用最大化边距补偿） -->
    <Grid x:Name="根容器">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <!-- ══ 顶栏 ══════════════════════════════════════════════════
             平色主蓝 + 底部 1px 半透明白描边线：深色主题下给壳层一条"地平线"，
             与下方内容区分层（不用阴影，守铁律 1） -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}"
                BorderBrush="{DynamicResource OnPrimaryEdgeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 站名（此区域留给 WindowChrome 拖窗，勿加命中测试）
                     2026-11-26：开源版移除公司 Logo，顶栏只留文字，不配任何图标 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="24,0,16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding 工位名称}" Style="{StaticResource TopBarTitle}" />
                        <TextBlock Text="{Binding 工位副标题}" Style="{StaticResource TopBarText}"
                                   Margin="{StaticResource GapTop4}" />
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：连接状态 + 身份 + 时钟 + 窗口控制
                     IsHitTestVisibleInChrome 必须逐个覆盖到交互元素上，
                     否则点下去会变成"拖窗口"而不是"按按钮"。 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <views:辉光状态灯 Style="{StaticResource ConnectionGlowDot}"
                             Fill="{Binding 连接状态颜色键, Converter={StaticResource KeyToBrush}}" />
                    <TextBlock Text="{Binding 连接状态文本}" Style="{StaticResource TopBarText}"
                               Margin="{StaticResource GapRight16}" />

                    <Border Width="1" Height="22" Background="{DynamicResource OnPrimaryDividerBrush}"
                            Margin="{StaticResource GapRight16}" VerticalAlignment="Center" />

                    <!-- 当前身份 + 切换 -->
                    <TextBlock Text="{Binding 用户显示文本}" Style="{StaticResource TopBarText}"
                               Margin="{StaticResource GapRight12}"
                               ToolTip="当前登录身份决定可访问的页面与可编辑的内容" />

                    <Button Content="切换身份" Command="{Binding 切换用户Command}"
                            Style="{StaticResource ShellButton}"
                            Margin="{StaticResource GapRight8}"
                            ToolTip="以其他身份重新登录" />

                    <Button Content="退出" Command="{Binding 退出登录用户Command}"
                            Style="{StaticResource ShellGhostButton}"
                            Margin="{StaticResource GapRight16}" />

                    <Border Width="1" Height="22" Background="{DynamicResource OnPrimaryDividerBrush}"
                            Margin="{StaticResource GapRight16}" VerticalAlignment="Center" />

                    <TextBlock Text="{Binding 当前时间文本}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="14" Foreground="{DynamicResource TextOnPrimaryBrush}"
                               VerticalAlignment="Center" Margin="{StaticResource GapRight20}" />

                    <!-- 窗口控制键：与右侧边缘齐平（Fluent 习惯），故不加右边距 -->
                    <Button Style="{StaticResource WindowButton}" Click="最小化_Click"
                            ToolTip="最小化">
                        <Path Style="{StaticResource WindowGlyph}" Data="M1,6 H11" />
                    </Button>

                    <Button Style="{StaticResource WindowButton}" Click="最大化或还原_Click"
                            ToolTip="最大化 / 还原">
                        <Grid>
                            <Path Data="M1.5,1.5 H10.5 V10.5 H1.5 Z" StrokeThickness="1.4"
                                  Stretch="None" Width="12" Height="12" Focusable="False"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M1.5,4 H8 V10.5 H1.5 Z M4,4 V1.5 H10.5 V8" StrokeThickness="1.4"
                                  Stretch="None" Width="12" Height="12" Focusable="False"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowCloseButton}" Click="关闭_Click"
                            ToolTip="关闭">
                        <Path Style="{StaticResource WindowGlyph}" Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 告警横幅区（配置降级 + 运行期异常，纵向堆叠）════════════
             配置读不出来时程序仍会启动（可用性优先），但必须让操作员看见。
             报警表损坏却安静地显示"无报警"，比直接崩溃更危险。
             两条横幅都不自动消失、不可关闭；无问题时整条折叠，不占空间。 -->
        <StackPanel Grid.Row="1">
            <Border Padding="16,10"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{Binding 配置问题颜色键, Converter={StaticResource KeyToBrush}}"
                    BorderThickness="3,0,0,0"
                    Visibility="{Binding 有配置问题, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AlarmBarIcon}" Margin="{StaticResource GapRight8}"
                          Data="{StaticResource Icon.Status.Alarm}"
                          Stroke="{Binding 配置问题颜色键, Converter={StaticResource KeyToBrush}}" />
                    <TextBlock Text="{Binding 配置问题文本}"
                               Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 运行期异常与配置问题分开：前者是"刚刚发生的、可能一闪而过"，
                 后者是"启动时发现的、持续的"，操作员的处理动作不同。
                 刻意不用 MessageBox —— 模态框会阻断界面直到有人来点确定。 -->
            <Border Padding="16,10"
                    Background="{Binding 运行期错误底色键, Converter={StaticResource KeyToBrush}}"
                    BorderBrush="{Binding 运行期错误颜色键, Converter={StaticResource KeyToBrush}}"
                    BorderThickness="3,0,0,0"
                    Visibility="{Binding 有运行期错误, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AlarmBarIcon}" Margin="{StaticResource GapRight8}"
                          Data="{StaticResource Icon.Status.Alarm}"
                          Stroke="{Binding 运行期错误颜色键, Converter={StaticResource KeyToBrush}}" />
                    <TextBlock Text="{Binding 运行期错误文本}"
                               Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 模拟模式横幅：与"配置异常/程序异常"不同，它不是故障，而是运行状态。
                 但仍必须常驻可见——不能让操作员把内置虚拟 PLC 的数据当成真实设备反馈。 -->
            <Border Padding="16,10"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningStrongBrush}"
                    BorderThickness="3,0,0,0"
                    Visibility="{Binding 是模拟模式, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource AlarmBarIcon}" Margin="{StaticResource GapRight8}"
                          Data="{StaticResource Icon.Status.Alarm}"
                          Stroke="{DynamicResource WarningStrongBrush}" />
                    <TextBlock Text="{Binding 模拟模式文本}"
                               Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══ 主体：侧栏 + 内容 ═════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding 侧栏已收起, Converter={StaticResource SidebarWidth}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏导航（可收起为 64px 纯图标栏，P3 响应式） -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <!-- DockPanel 的最后一个子元素会填满剩余空间（LastChildFill=True）。
                     版本号必须排在 ListBox 之前：否则它会抢走填充区、导航列表反被按默认的
                     Left 停靠，结果是导航高亮只有半栏宽、版本号还叠在导航上方。 -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="功能导航"
                               Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource NavHeaderMargin}"
                               Visibility="{Binding 侧栏已收起, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding 版本号}"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" Margin="{StaticResource GapBottom16}"
                               Visibility="{Binding 侧栏已收起, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                    <!-- 收起 / 展开切换：箭头方向 = 点击后侧栏的去向 -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Center" Margin="{StaticResource GapBottom8}"
                            ToolTip="收起 / 展开导航栏"
                            Command="{Binding 切换侧栏Command}">
                        <Path Data="M9,3 L3,8 L9,13" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource IconButtonGlyph}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.侧栏已收起, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <ListBox Style="{StaticResource NavListBox}"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             ItemsSource="{Binding 导航条目集合}"
                             SelectedItem="{Binding 选中导航条目}"
                             Margin="{StaticResource NavListMargin}" />
                </DockPanel>
            </Border>

            <!-- 内容区：平色浅底，不与卡片争注意力 -->
            <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                <ContentControl x:Name="内容宿主" Content="{Binding 当前页面}" />
            </Border>
        </Grid>

        <!-- ══ 底部报警条 ════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="{StaticResource BarMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 颜色指示条 -->
                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="{StaticResource GapV12}"
                        Background="{Binding 报警栏颜色键, Converter={StaticResource KeyToBrush}}" />

                <!-- 报警条整体可点：报警出现后操作员的下一跳一键可达（P2 动线闭环） -->
                <Button Grid.Column="1" Command="{Binding 打开报警Command}" Cursor="Hand"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        ToolTip="点击打开报警记录页">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <!-- 2026-10-16 现场要求：底栏报警条放大（图标 24→32、文字 13→16 加粗），
                             让"有报警"在任何页面都一眼可见 -->
                        <Path Style="{StaticResource AlarmBarIcon}" Margin="{StaticResource GapRight12}"
                              Width="32" Height="32" StrokeThickness="1.9"
                              Data="{StaticResource Icon.Status.Alarm}"
                              Stroke="{Binding 报警栏颜色键, Converter={StaticResource KeyToBrush}}" />
                        <TextBlock Text="{Binding 报警栏文本}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="查看 ›" Style="{StaticResource CaptionText}"
                                   Foreground="{DynamicResource PrimaryLightBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource GapLeft12}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
