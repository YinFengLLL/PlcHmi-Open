<Window x:Class="PlcHmi.App.Views.PopupSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="弹窗设置"
        Width="1020" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <!--
        布局约定（2026-10-17 重排，修"控件重合 / 显示不全"）：
        ① 所有列一律用 * / Auto，不再写死像素宽度——原来 名称/地址两栏写死 180+150，
           窗口一窄就溢出所在列，与相邻列叠在一起（现场看到的"重合"）。
        ② 窗口改 SizeToContent="Height"：内容多高窗口就多高，长文案不会被固定高度裁掉。
        ③ 列表区 MaxHeight + 纵向滚动：弹窗个数多时靠滚动，不挤压底部按钮。
    -->
    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom12}">
            <TextBlock Style="{StaticResource DialogTitleText}" Text="弹窗设置 · 仅管理员" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop8}"
                       TextWrapping="Wrap"
                       Text="弹窗与 M 区地址是实时关系：触发地址闭合（ON）时主界面居中显示该弹窗，断开（OFF）立即消失。每个按钮可单独选模式：复归型（按住置位、松开复位）、置位 ON（点一次并保持）、复位 OFF（点一次并保持）。" />
        </StackPanel>

        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource GapBottom8}">
                <Button Content="＋ 新增弹窗" Style="{StaticResource SecondaryButton}"
                        Width="150" Height="40" Margin="{StaticResource GapRight8}"
                        Click="AddPopup" />
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="触发地址与按钮地址必须是 M 区线圈；按钮名称留空则该按钮不显示。" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PopupCollection}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="14,12">
                                    <!-- 每个弹窗一张卡片：名称 / 触发地址 / 删除 一行，内容一行，两个按钮各一行 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 行 1：名称 / 触发地址 / 删除 -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource GapRight12}">
                                            <TextBlock Text="弹窗名称" Style="{StaticResource CaptionText}" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputBox}" Height="36"
                                                     Margin="{StaticResource GapTop4}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="{StaticResource GapRight12}">
                                            <TextBlock Text="触发地址（M 区，闭合显示）" Style="{StaticResource CaptionText}" />
                                            <TextBox Text="{Binding TriggerAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputBox}" Height="36"
                                                     FontFamily="{StaticResource NumericFontFamily}"
                                                     Margin="{StaticResource GapTop4}" />
                                        </StackPanel>

                                        <Button Grid.Row="0" Grid.Column="2"
                                                Content="删除" Style="{StaticResource ButtonDanger}"
                                                Width="72" Height="36" Margin="{StaticResource GapLeft12}"
                                                VerticalAlignment="Bottom"
                                                Click="DeletePopup" />

                                        <!-- 行 2：内容（跨两列，多行文本） -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Margin="{StaticResource GapTop8Right12}">
                                            <TextBlock Text="弹窗内容" Style="{StaticResource CaptionText}" />
                                            <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputBox}" Height="56"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Margin="{StaticResource GapTop4}" />
                                        </StackPanel>

                                        <!-- 行 3：按钮一（名称 * / 地址 * / 模式 Auto） -->
                                        <Grid Grid.Row="2" Grid.Column="0" Margin="{StaticResource GapTop8Right12}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="按钮一名称" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Button1Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputBox}" Height="36"
                                                         Margin="{StaticResource GapTop4}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="按钮一地址（M）" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Button1Address, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputBox}" Height="36"
                                                         FontFamily="{StaticResource NumericFontFamily}"
                                                         Margin="{StaticResource GapTop4}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Width="120">
                                                <TextBlock Text="模式" Style="{StaticResource CaptionText}" />
                                                <ComboBox Height="36" VerticalContentAlignment="Center"
                                                          Margin="{StaticResource GapTop4}"
                                                          ItemsSource="{Binding ModeOptions}"
                                                          SelectedIndex="{Binding Button1ModeIndex, Mode=TwoWay}"
                                                          ToolTip="复归型：按住置位、松开复位；置位 ON / 复位 OFF：点一次并保持" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 行 4：按钮二（名称 * / 地址 * / 模式 Auto） -->
                                        <Grid Grid.Row="3" Grid.Column="0" Margin="{StaticResource GapTop8Right12}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="按钮二名称（可留空）" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Button2Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputBox}" Height="36"
                                                         Margin="{StaticResource GapTop4}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="按钮二地址（M）" Style="{StaticResource CaptionText}" />
                                                <TextBox Text="{Binding Button2Address, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputBox}" Height="36"
                                                         FontFamily="{StaticResource NumericFontFamily}"
                                                         Margin="{StaticResource GapTop4}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Width="120">
                                                <TextBlock Text="模式" Style="{StaticResource CaptionText}" />
                                                <ComboBox Height="36" VerticalContentAlignment="Center"
                                                          Margin="{StaticResource GapTop4}"
                                                          ItemsSource="{Binding ModeOptions}"
                                                          SelectedIndex="{Binding Button2ModeIndex, Mode=TwoWay}"
                                                          ToolTip="复归型：按住置位、松开复位；置位 ON / 复位 OFF：点一次并保持" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <TextBlock x:Name="MessageText" Grid.Row="2" Text=""
                   Foreground="{DynamicResource DangerBrush}"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="{StaticResource GapTop8}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource GapTop12}">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="110" Height="44" Margin="{StaticResource GapRight12}"
                    Click="Cancel" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                    Width="130" Height="44"
                    Click="Confirm" />
        </StackPanel>
    </Grid>
</Window>
