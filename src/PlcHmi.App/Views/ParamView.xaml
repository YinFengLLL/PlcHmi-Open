<UserControl x:Class="PlcHmi.App.Views.ParameterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PlcHmi.App.Converters"
             xmlns:vm="clr-namespace:PlcHmi.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ParameterViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BooleanVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="TableHeaderText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="{StaticResource GapV12}" />
        </Style>

        <!-- 行内边距 0,8：行高约 44px，兼顾触控目标与信息密度 -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}"
          Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 机种 -->
        <Grid Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
            </StackPanel>

            <Border Grid.Column="1" Padding="{StaticResource ToolBarPadding}" CornerRadius="8"
                    Background="{DynamicResource PrimarySoftBrush}"
                    BorderBrush="{DynamicResource PrimaryLightBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding RecipeBadgeMark}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <ScrollViewer PanningMode="VerticalOnly" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ══ 1. 轴速度表 ══ -->
                <Border Style="{StaticResource CardBorder}" Margin="{StaticResource GapBottom16}">
                    <StackPanel>
                        <TextBlock Text="轴速度" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="每个轴只保留定位速度；改动不会立即写 PLC。地址为 D 区 32 位浮点（占 2 字），仅管理员可改；地址改完按「保存」或「保存轴地址」生效"
                                   Style="{StaticResource CaptionText}" Margin="{StaticResource SectionCaptionMargin}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="轴" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="定位速度" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="地址" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="单位" Style="{StaticResource TableHeaderText}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AxisSpeed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryBrush}" />

                                            <TextBox Grid.Column="1" Style="{StaticResource NumericInputBox}"
                                                     Width="180" HorizontalAlignment="Left"
                                                     Text="{Binding PositioningSpeedText, UpdateSourceTrigger=PropertyChanged}" />

                                            <!-- 地址列用 PropertyChanged 而不是 LostFocus：
                                                 保存轴地址按钮在页面下方的另一张卡片里，改完要滚动过去再点，
                                                 依赖"失焦才提交"会让未提交的输入被静默丢弃（现场：改了地址保存不了）。
                                                 校验仍在按「保存轴地址」时统一做，逐字提交无副作用。 -->
                                            <TextBox Grid.Column="2" Style="{StaticResource InputBox}"
                                                     Width="110" HorizontalAlignment="Left"
                                                     Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding DataContext.EditableTable,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Visibility="{Binding ShowPhysicalAddress, Converter={StaticResource BoolToVis}}"
                                                     ToolTip="定位速度寄存器（D 区，32 位浮点占 2 字，可省前缀写作 1252）。改完按「保存」或「保存轴地址」生效" />

                                            <!-- OPC UA 模式：地址列直接显示绑定变量名，物理地址不参与寻址 -->
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource CaptionText}"
                                                       Width="180" HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding BindShowText}"
                                                       Visibility="{Binding VariableAddressingMode, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="OPC UA 模式按变量名符号寻址；点右侧「选变量…」在变量表中选取" />

                                            <Button Grid.Column="3" Content="选变量…"
                                                    Style="{StaticResource SecondaryButton}" Height="36"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.SelectPositioningSpeedVariableCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.EditableTable,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                                 Converter={StaticResource BoolToVis}}"
                                                    ToolTip="从汇川变量表为定位速度选择变量（OPC UA 模式按变量名符号寻址）" />

                                            <TextBlock Grid.Column="4" Text="{Binding Unit}"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══ 2. 延时表 ══ -->
                <Border Style="{StaticResource CardBorder}" Margin="{StaticResource GapBottom16}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="延时" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="动作之间的等待时间；界面按秒显示（XX.XXX S），PLC 侧按 32 位整数毫秒（DINT，每条占 2 字、地址间隔 2）存储；工程师可改数值，增删与改地址仅管理员"
                                           Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="+ 新增延时" Style="{StaticResource SecondaryButton}"
                                    Height="44" VerticalAlignment="Top"
                                    Command="{Binding AddDelayAsyncCommand}"
                                    Visibility="{Binding EditableTable, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Grid Margin="{StaticResource GapTop12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="当前值" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="地址" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="启用" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource TableHeaderText}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DelayCollection}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Opacity="{Binding RowOpacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBox Grid.Column="1"
                                                     Style="{StaticResource NumericInputBox}"
                                                     Width="140" HorizontalAlignment="Left"
                                                     Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                                     IsEnabled="{Binding DataContext.OperableValueList,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     ToolTip="延时（秒，最多 3 位小数）；输入完移开焦点即实时写入 PLC 并保存到配置文件，无需按「下发到 PLC」" />

                                            <TextBlock Grid.Column="2" Text="{Binding Address}"
                                                       Style="{StaticResource CaptionText}"
                                                       FontFamily="{StaticResource NumericFontFamily}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                        <Setter Property="Text" Value="已停用" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="已启用" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding DataContext.EditableTable,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVis}}">
                                                <Button Content="✎" FontSize="16" ToolTip="编辑延时名称、数值与绑定地址"
                                                        Style="{StaticResource IconButton}" Margin="{StaticResource GapRight8}"
                                                        Command="{Binding DataContext.EditDelayAsyncCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" FontSize="16" ToolTip="删除该延时条目"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.RemoveDelayAsyncCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══ 3. 按钮表 ══ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="按钮" Style="{StaticResource SectionTitleText}" />
                                <TextBlock
                                    Text="可置位 / 复位的 M 区开关（地址限定 M5000–M5099）；「开关」列是上位机最近一次操作的记忆，不回读 PLC"
                                    Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="+ 新增按钮" Style="{StaticResource SecondaryButton}"
                                    Height="44" VerticalAlignment="Top"
                                    Command="{Binding AddButtonAsyncCommand}"
                                    Visibility="{Binding EditableTable, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Grid Margin="{StaticResource GapTop12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="216" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="地址" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="开关" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="启用" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource TableHeaderText}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ButtonCollection}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Opacity="{Binding RowOpacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="216" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1" Text="{Binding Address}"
                                                       Style="{StaticResource CaptionText}"
                                                       FontFamily="{StaticResource NumericFontFamily}"
                                                       VerticalAlignment="Center" />

                                            <!-- 开关状态：上位机最近一次操作的记忆，不回读 PLC -->
                                            <TextBlock Grid.Column="2" Text="{Binding ButtonStateText}"
                                                       FontSize="12" VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                        <Setter Property="Text" Value="已停用" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="已启用" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- 写 PLC 的即时操作：48px 高 + 语义色来自组件库；
                                                     置位=Primary（普通命令），复位=Warning（回落动作）——
                                                     原先"绿色=置位"易被误读为安全无操作。
                                                     停用行同步禁用（RowOpacity 只是视觉暗示，这里是硬约束）。 -->
                                                <Button Content="置位" Style="{StaticResource PrimaryButton}"
                                                        Width="56" Height="48" FontSize="14" Margin="{StaticResource GapRight8}"
                                                        IsEnabled="{Binding IsEnabled}"
                                                        ToolTip="置位该 M 点（开启），即时写入 PLC"
                                                        Visibility="{Binding DataContext.OperableValueList,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.SetButtonAsOpenAsyncCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="复位" Style="{StaticResource ButtonWarning}"
                                                        Width="56" Height="48" FontSize="14" Margin="{StaticResource GapRight16}"
                                                        IsEnabled="{Binding IsEnabled}"
                                                        ToolTip="复位该 M 点（关闭），即时写入 PLC"
                                                        Visibility="{Binding DataContext.OperableValueList,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.SetButtonAsCloseAsyncCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✎" FontSize="16" ToolTip="编辑按钮名称与绑定地址"
                                                        Style="{StaticResource IconButton}" Margin="{StaticResource GapRight8}"
                                                        Visibility="{Binding DataContext.EditableTable,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.EditButtonAsyncCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" FontSize="16" ToolTip="删除该按钮条目"
                                                        Style="{StaticResource IconButton}"
                                                        Visibility="{Binding DataContext.EditableTable,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RemoveButtonAsyncCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══ 4. 轴地址（仅管理员） ══
                     定位速度地址在上方「轴速度」表中改（唯一编辑入口）；
                     这里集中其余三类随轴切换的地址。 -->
                <Border Style="{StaticResource CardBorder}" Margin="{StaticResource GapTop16}"
                        Visibility="{Binding EditableTable, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="轴地址" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="六轴（锁附 X/Y/Z/ZZ · 点胶 X/Z）随轴切换的四类地址 · 定位速度地址请在上方「轴速度」表中修改 · 改完按「保存」或「保存轴地址」生效"
                                   Style="{StaticResource CaptionText}" Margin="{StaticResource SectionCaptionMargin}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="轴" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="当前位置" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="正转点动" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="反转点动" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="点动档位" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="5" Text="轴回零" Style="{StaticResource TableHeaderText}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AxisAddressCollection}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryBrush}" />

                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                                     Width="116" HorizontalAlignment="Left"
                                                     Text="{Binding PositionAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="当前位置寄存器（D 区，32 位浮点占 2 字，可省前缀写作 1221）" />

                                            <TextBox Grid.Column="2" Style="{StaticResource InputBox}"
                                                     Width="96" HorizontalAlignment="Left"
                                                     Text="{Binding JogForwardAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="正转点动命令，M 区线圈或 D 区字内位（如 D1210.2，上位机只置位内部继电器/命令位）" />

                                            <TextBox Grid.Column="3" Style="{StaticResource InputBox}"
                                                     Width="96" HorizontalAlignment="Left"
                                                     Text="{Binding JogReverseAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="反转点动命令，M 区线圈或 D 区字内位（如 D1210.3）" />

                                            <TextBox Grid.Column="4" Style="{StaticResource InputBox}"
                                                     Width="88" HorizontalAlignment="Left"
                                                     Text="{Binding JogSpeedLevelAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="点动速度档位寄存器（D 区单字），写 1 低速 / 2 中速 / 3 高速；六轴必须填同一个地址" />

                                            <TextBox Grid.Column="5" Style="{StaticResource InputBox}"
                                                     Width="96" HorizontalAlignment="Left"
                                                     Text="{Binding HomeAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="轴回零命令，M 区线圈或 D 区字内位（如 M440）；留空表示该轴不提供回零按钮" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource GapTop12}">
                            <Button Content="保存轴地址" Style="{StaticResource PrimaryButton}"
                                    Height="44" Width="150"
                                    Command="{Binding SaveAxisAddressAsyncCommand}" />
                            <TextBlock Text="保存后会重建采集计划，新地址立即生效，无需重启程序；请先确认 PLC 侧读取地址已同步改好"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                       Margin="{StaticResource GapLeft12}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Grid Grid.Row="2" Margin="{StaticResource GapTop16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StateText}"
                       Style="{StaticResource BodyText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource GapRight12}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="读取" Style="{StaticResource SecondaryButton}" Width="90"
                        Margin="{StaticResource GapRight12}" Command="{Binding ReadCommand}" />
                <Button Content="下发到 PLC" Style="{StaticResource PrimaryButton}" Width="140"
                        Margin="{StaticResource GapRight12}" Command="{Binding WriteAsyncCommand}" />
                <Button Content="保存到本地" Style="{StaticResource SecondaryButton}" Width="120"
                        Margin="{StaticResource GapRight20}" Command="{Binding SaveAsyncCommand}" />
                <!-- 恢复默认会覆盖界面上全部已调参数：危险操作独立样式 + 与常规按钮拉开间距（已带确认框） -->
                <Button Content="恢复默认" Style="{StaticResource DangerousActionButton}" Width="140"
                        Command="{Binding RestoreDefaultValueCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
