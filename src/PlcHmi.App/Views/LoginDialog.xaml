<Window x:Class="上位机.应用.视图.登录对话框"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="身份登录"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom20}">
            <TextBlock Text="身份登录" Style="{StaticResource DialogTitleText}" />
            <TextBlock Text="不同身份可操作的页面与功能不同"
                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop8}" />
        </StackPanel>

        <!-- 账号 -->
        <StackPanel Grid.Row="1" Margin="{StaticResource GapBottom16}">
            <TextBlock Text="账号" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <ComboBox x:Name="账号框" Height="44" VerticalContentAlignment="Center" />
        </StackPanel>

        <!-- 密码 -->
        <StackPanel Grid.Row="2" Margin="{StaticResource GapBottom16}">
            <TextBlock Text="密码" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <PasswordBox x:Name="密码框" Height="44" Padding="10,0"
                         VerticalContentAlignment="Center"
                         KeyDown="密码键按下" />
        </StackPanel>

        <!-- 提示信息 -->
        <TextBlock x:Name="消息文本" Grid.Row="3"
                   Text="" Foreground="{DynamicResource DangerBrush}"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" MinHeight="18" />

        <!-- 初始密码提示：只在所选账号仍用初始密码时出现，且不再明文印出密码
             （密码印在公共屏幕上等于权限体系失效；初始密码由管理员线下告知）。
             行高随内容自适应（SizeToContent=Height），提示换多行不再被按钮行裁掉 -->
        <Border Grid.Row="4" VerticalAlignment="Top" Margin="{StaticResource GapTop8}"
                Padding="12,10" CornerRadius="8"
                Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
            <!-- 浅橙底上用正文灰蓝(4.82:1)，橙字只有 4.04:1 不达标；警示语义由软底+橙边框承担 -->
            <StackPanel>
                <TextBlock x:Name="默认密码提示" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                           Visibility="Collapsed"
                           Text="所选账号仍在使用初始密码，请登录后立即在「系统设置」中修改。" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                           Text="初始密码请向管理员获取。取消登录将以操作员身份进入（只能查看运行、IO 与报警）。" />
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="以操作员身份进入" Style="{StaticResource SecondaryButton}"
                    Width="170" Height="44" Margin="{StaticResource GapRight12}" Click="跳过" />
            <Button Content="登录" Style="{StaticResource PrimaryButton}"
                    Width="110" Height="44" IsDefault="True" Click="确认" />
        </StackPanel>
    </Grid>
</Window>
