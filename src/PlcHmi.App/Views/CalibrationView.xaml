<UserControl x:Class="PlcHmi.App.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PlcHmi.App.Converters"
             xmlns:svc="clr-namespace:PlcHmi.App.Services"
             xmlns:vm="clr-namespace:PlcHmi.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:CalibrationViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BooleanVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}" Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom12}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <!-- 标定示教与其它点坐标同屏上下排布（2026-10-15 现场要求合并为一个页面）。
             刻意不开 PanningMode：页面里有"按住即动"的点动按钮，让 ScrollViewer 抢走触摸
             会导致"松手轴还在动"——与手动页 / 示教页同一取舍（见 Themes/Controls.xaml）。 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource GapBottom16}">

                <!-- ══ 1. 标定示教 ══ -->
                <Grid Margin="{StaticResource GapTop12}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列：与锁附示教页同一套元件（中心点坐标 / 标定动作 / 动作按钮 / 辅助地址） -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                    <!-- ① 上相机标定：中心点 X/Y/Z + 偏移量 + 标定启动（2026-10-17 改名，原「标定中心点/偏移量」） -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="{StaticResource ToolBarPadding}" Margin="{StaticResource GapBottom12}">
                        <StackPanel>
                            <TextBlock Text="上相机标定" Style="{StaticResource SectionTitleText}"
                                       Margin="{StaticResource GapBottom8}" />

                            <TextBlock Text="上相机标定中心点" Style="{StaticResource BodyText}"
                                       Margin="{StaticResource GapBottom4}" />

                            <Grid Margin="{StaticResource GapBottom8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" MaxLength="12"
                                         FontFamily="{StaticResource NumericFontFamily}"
                                         Text="{Binding CenterX, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="{StaticResource GapRight12}" />
                                <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                                <TextBox Grid.Column="3" Style="{StaticResource InputBox}" MaxLength="12"
                                         FontFamily="{StaticResource NumericFontFamily}"
                                         Text="{Binding CenterY, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="{StaticResource GapRight12}" />
                                <TextBlock Grid.Column="4" Text="Z" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                                <TextBox Grid.Column="5" Style="{StaticResource InputBox}" MaxLength="12"
                                         FontFamily="{StaticResource NumericFontFamily}"
                                         Text="{Binding CenterZ, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="{StaticResource GapBottom12}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="上相机标定偏移量" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" MaxLength="12"
                                         FontFamily="{StaticResource NumericFontFamily}"
                                         Text="{Binding OffsetValue, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="写入中心点" Style="{StaticResource SecondaryButton}" Width="112"
                                        Height="42" Margin="{StaticResource GapRight8}"
                                        Command="{Binding WriteCenterAsyncCommand}" />
                                <Button Content="写入偏移量" Style="{StaticResource SecondaryButton}" Width="112"
                                        Height="42" Margin="{StaticResource GapRight8}"
                                        Command="{Binding WriteOffsetAsyncCommand}" />
                                <Button Content="上相机标定启动" Style="{StaticResource PrimaryButton}" Width="136"
                                        Height="42" Command="{Binding CalibrationStartAsyncCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ② 下相机标定：起点 X/Z + 偏移量 + 标定启动（2026-10-17 新增；没有 Y） -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="{StaticResource ToolBarPadding}"
                            Margin="{StaticResource GapBottom12}">
                        <StackPanel>
                            <TextBlock Text="下相机标定" Style="{StaticResource SectionTitleText}"
                                       Margin="{StaticResource GapBottom8}" />

                            <Grid Margin="{StaticResource GapBottom8}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" MaxLength="12"
                                         FontFamily="{StaticResource NumericFontFamily}"
                                         Text="{Binding BottomCameraX, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="{StaticResource GapRight12}" />
                                <!-- 下相机只有 X / Z：没有 Y 输入（与上相机的唯一差别） -->
                                <TextBlock Grid.Column="2" Text="Z" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                                <TextBox Grid.Column="3" Style="{StaticResource InputBox}" MaxLength="12"
                                         FontFamily="{StaticResource NumericFontFamily}"
                                         Text="{Binding BottomCameraZ, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="{StaticResource GapBottom12}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="下相机标定偏移量" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" MaxLength="12"
                                         FontFamily="{StaticResource NumericFontFamily}"
                                         Text="{Binding BottomCameraOffset, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="写入起点" Style="{StaticResource SecondaryButton}" Width="112"
                                        Height="42" Margin="{StaticResource GapRight8}"
                                        Command="{Binding WriteBottomCameraCenterAsyncCommand}" />
                                <Button Content="写入偏移量" Style="{StaticResource SecondaryButton}" Width="112"
                                        Height="42" Margin="{StaticResource GapRight8}"
                                        Command="{Binding WriteBottomCameraOffsetAsyncCommand}" />
                                <Button Content="下相机标定启动" Style="{StaticResource PrimaryButton}" Width="136"
                                        Height="42" Command="{Binding BottomCameraCalibrationStartAsyncCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ③ 标定动作：地址编辑入口 + 联锁说明 -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="{StaticResource ToolBarPadding}"
                            Margin="{StaticResource GapBottom12}">
                        <StackPanel>
                            <TextBlock Text="标定动作" Style="{StaticResource SectionTitleText}"
                                       Margin="{StaticResource GapBottom8}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑地址" Style="{StaticResource SecondaryButton}" Width="110"
                                        Visibility="{Binding EditableAddress, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding EditAddressAsyncCommand}"
                                        ToolTip="编辑上/下相机的中心点、偏移量、标定启动地址，以及点动 / 回零 的地址（仅管理员）" />
                            </StackPanel>
                            <TextBlock Text="两个标定启动各自置位对应的 M 区内部继电器，由 PLC 执行；未开启手动使能时都会被拒绝。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="{StaticResource GapTop8}" />
                        </StackPanel>
                    </Border>

                    <!-- 动作按钮（与锁附示教页同一套配置：默认空，管理员可在「编辑地址」中新增） -->
                    <Border Style="{StaticResource CardBorder}" Padding="{StaticResource ToolBarPadding}"
                            Margin="{StaticResource GapBottom12}">
                        <StackPanel>
                            <TextBlock Text="动作" Style="{StaticResource SectionTitleText}"
                                       Margin="{StaticResource GapBottom8}" />
                            <ItemsControl ItemsSource="{Binding ActionButtonCollection}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 切换型动作按钮：首次按下置位（激活）、再次按下复位；
                                             激活时用成功色高亮，状态一眼可见（不再弹确认框） -->
                                        <Button MinWidth="104" Height="42" Margin="0,0,10,10"
                                                Content="{Binding Name}"
                                                ToolTip="{Binding StateHint}"
                                                Command="{Binding DataContext.TriggerActionAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ButtonNeutral}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activated}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="动作按钮为切换型：按一次置位（激活，按钮变绿），再按一次复位。只操作 M 区内部继电器，由 PLC 程序执行实际动作；未开启手动使能时会被拒绝。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="{StaticResource GapTop8}" />
                        </StackPanel>
                    </Border>

                    <!-- 辅助地址（与锁附示教页同一套配置：默认空，管理员可新增 / 删除） -->
                    <Border Style="{StaticResource CardBorder}" Padding="{StaticResource ToolBarPadding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="{StaticResource GapBottom8}">
                                <TextBlock Text="辅助地址" Style="{StaticResource SectionTitleText}"
                                           VerticalAlignment="Center" />
                                <Button Content="读取" Style="{StaticResource SmallButton}" Width="72" Height="34"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ReadAuxAddressValueAsyncCommand}" />
                            </Grid>

                            <TextBlock DockPanel.Dock="Bottom"
                                       Text="数值填完按回车（或点别处）即写入 PLC，并实时显示 PLC 现值；未开手动使能时只能查看。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="{StaticResource GapTop8}" />

                            <!-- 实时读写（2026-11-12）：不再有「写入」按钮，值随 PLC 周期回读 -->
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AuxAddressCollection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                               FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource CaptionText}" FontSize="13"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding AddressText, Mode=OneWay}" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding Unit, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                                         VerticalContentAlignment="Center" Height="36"
                                                         FontFamily="{StaticResource NumericFontFamily}"
                                                         MaxLength="12"
                                                         Visibility="{Binding IsNumericValue, Converter={StaticResource BoolToVis}}"
                                                         IsEnabled="{Binding Editable}"
                                                         ToolTip="{Binding InputHint}"
                                                         svc:InputSubmitGesture.Additional="True"
                                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Visibility="{Binding IsSwitch, Converter={StaticResource BoolToVis}}"
                                                          IsEnabled="{Binding Editable}"
                                                          ToolTip="{Binding InputHint}"
                                                          IsChecked="{Binding SwitchState}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 手动点动（锁附 X / Y / Z） -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}"
                            Padding="{StaticResource ToolBarPadding}">
                        <StackPanel>
                            <TextBlock Text="手动（锁附 X / Y / Z）" Style="{StaticResource SectionTitleText}"
                                       Margin="{StaticResource GapBottom8}" />

                            <Border Padding="{StaticResource ChipPadding}" CornerRadius="8"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                    Margin="{StaticResource GapBottom12}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="手动使能" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="{StaticResource GapRight12}" />
                                    <CheckBox IsChecked="{Binding IsManualEnabled}" VerticalAlignment="Center"
                                              ToolTip="与手动调试 / 锁附示教 / 点胶示教共用同一个使能开关；开启即置位 PLC 的 M666" />
                                </StackPanel>
                            </Border>

                            <!-- 锁附 X / Y / Z 轴当前位置：与锁附示教页同一套配置、同一套显示风格
                                 （上方轴名、下方数值，等宽数字）。示教页那套可点选轴做回零，
                                 本页只显示、不参与操作。 -->
                            <ItemsControl ItemsSource="{Binding AxisList}"
                                          Margin="{StaticResource GapBottom12}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinWidth="96" Height="46" CornerRadius="8"
                                                Padding="{StaticResource ChipPadding}"
                                                Margin="{StaticResource GapRight4}"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                                BorderThickness="1"
                                                ToolTip="轴当前位置（与锁附示教页同一个位置点位）">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding PositionText}" HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource NumericFontFamily}"
                                                           FontSize="13" Opacity="0.9" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 用 Grid + 显式间距（不用 UniformGrid）：UniformGrid 不留缝，
                                 六个按钮会连成一整块蓝色，分不清按的是哪一个。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 统一方向键盘：上 Y− / 下 Y+ / 左 X− / 右 X+，中央档位切换；Z 另一组上下箭头 -->
                                <Button Grid.Row="0" Grid.Column="1" Content="Y−" Tag="Y-"
                                        Style="{StaticResource ButtonNeutral}" Height="56"
                                        Margin="2,0,2,8" ToolTip="按住 Y 轴负向点动，松开停止" />
                                <Button Grid.Row="1" Grid.Column="0" Content="X−" Tag="X-"
                                        Style="{StaticResource ButtonNeutral}" Height="56"
                                        Margin="0,0,2,8" ToolTip="按住 X 轴负向点动，松开停止" />
                                <Button Grid.Row="1" Grid.Column="1" Height="56" Margin="2,0,2,8"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SwitchCalibrationGearAsyncCommand}"
                                        ToolTip="切换点动档位（低=0 / 中=1 / 高=2），六轴共用同一档位地址">
                                    <StackPanel>
                                        <TextBlock Text="档位" HorizontalAlignment="Center" FontSize="12" />
                                        <TextBlock Text="{Binding GearText}" HorizontalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="2" Content="X+" Tag="X+"
                                        Style="{StaticResource ButtonNeutral}" Height="56"
                                        Margin="2,0,0,8" ToolTip="按住 X 轴正向点动，松开停止" />
                                <Button Grid.Row="2" Grid.Column="1" Content="Y+" Tag="Y+"
                                        Style="{StaticResource ButtonNeutral}" Height="56"
                                        Margin="2,0,2,0" ToolTip="按住 Y 轴正向点动，松开停止" />

                                <!-- Z 组：上 Z− / 下 Z+ -->
                                <Button Grid.Row="0" Grid.Column="3" Content="Z−" Tag="Z-"
                                        Style="{StaticResource ButtonNeutral}" Height="56"
                                        Margin="12,0,2,8" ToolTip="按住 Z 轴负向点动，松开停止" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Z 轴" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Row="2" Grid.Column="3" Content="Z+" Tag="Z+"
                                        Style="{StaticResource ButtonNeutral}" Height="56"
                                        Margin="12,0,0,0" ToolTip="按住 Z 轴正向点动，松开停止" />
                            </Grid>

                            <TextBlock Text="按住方向键点动，松开即停（拖出按钮或切换窗口同样会停止）。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="{StaticResource GapTop8}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ 2. 其它点坐标：点行可选中，选中即把点码（0 基）写进 PLC 的 D653 ══ -->
                <TextBlock Text="其它点坐标" Style="{StaticResource SectionTitleText}"
                           Margin="{StaticResource GapTop20}" />
                <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource CaptionText}"
                           Margin="{StaticResource GapTop8}" />

                <Grid Margin="{StaticResource GapTop12}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource GapBottom12}">
                        <TextBlock Text="查询" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Margin="{StaticResource GapRight8}" />
                        <TextBox Width="200" Style="{StaticResource InputBox}" Margin="{StaticResource GapRight8}"
                                 Text="{Binding QueryKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="查询" Style="{StaticResource SecondaryButton}" Width="90" Height="40"
                                Margin="{StaticResource GapRight16}" Command="{Binding RefreshAuxPointCommand}" />
                        <Button Content="读取坐标" Style="{StaticResource SecondaryButton}" Width="110" Height="40"
                                Margin="{StaticResource GapRight8}" Command="{Binding ReadAllOtherPointAsyncCommand}" />
                        <Button Content="新增" Style="{StaticResource PrimaryButton}" Width="90" Height="40"
                                Margin="{StaticResource GapRight8}" Command="{Binding AddOtherPointAsyncCommand}" />
                        <Button Content="导出 CSV" Style="{StaticResource SecondaryButton}" Width="110" Height="40"
                                Margin="{StaticResource GapRight8}" Command="{Binding ExportCsvAsyncCommand}" />
                        <Button Content="导入 CSV" Style="{StaticResource SecondaryButton}" Width="110" Height="40"
                                Command="{Binding ImportCsvAsyncCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Background="{DynamicResource PrimarySoftBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="点号" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Margin="{StaticResource TableHeaderCellMargin}" />
                        <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" Margin="{StaticResource ToolBarPadding}" />
                        <TextBlock Grid.Column="2" Text="地址（X/Y/Z）" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}" />
                        <TextBlock Grid.Column="3" Text="X" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Margin="{StaticResource TableHeaderCellMargin}" />
                        <TextBlock Grid.Column="4" Text="Y" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Margin="{StaticResource TableHeaderCellMargin}" />
                        <TextBlock Grid.Column="5" Text="Z" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Margin="{StaticResource TableHeaderCellMargin}" />
                        <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}" />
                    </Grid>

                    <!-- 行高 48：与 IO / 报警页的点位行一致，触屏可点。
                         MaxHeight：本表在页面级滚动区里，不能再用 Height="*"（StackPanel 里星号不生效）。 -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AuxPointCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 点一下行空白处即选中该点：高亮 + 把点码写进 PLC 的 D653 -->
                                        <Border x:Name="其它点行根元素" Background="Transparent"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                ToolTip="点击该行空白处选中此点：PLC 的 D653 会收到该点号（0 基）">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedCommand}" />
                                            </Border.InputBindings>
                                            <Grid Height="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="其它点行点号" Grid.Column="0" Text="{Binding Tag}"
                                                           FontFamily="{StaticResource NumericFontFamily}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock x:Name="其它点行名称" Grid.Column="1" Text="{Binding Name}"
                                                           Style="{StaticResource BodyText}"
                                                           VerticalAlignment="Center"
                                                           Margin="{StaticResource GapLeft16}" />
                                                <TextBlock Grid.Column="2" Text="{Binding AddressText}"
                                                           Style="{StaticResource CaptionText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="3" Style="{StaticResource InputBox}"
                                                         FontFamily="{StaticResource NumericFontFamily}"
                                                         MaxLength="12" Margin="2,0" VerticalContentAlignment="Center"
                                                         Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="4" Style="{StaticResource InputBox}"
                                                         FontFamily="{StaticResource NumericFontFamily}"
                                                         MaxLength="12" Margin="2,0" VerticalContentAlignment="Center"
                                                         Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="5" Style="{StaticResource InputBox}"
                                                         FontFamily="{StaticResource NumericFontFamily}"
                                                         MaxLength="12" Margin="2,0" VerticalContentAlignment="Center"
                                                         Text="{Binding ZText, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                            Margin="{StaticResource GapRight8}">
                                                    <Button Content="写入" Style="{StaticResource SmallButton}"
                                                            Width="64" Height="38" Margin="{StaticResource GapRight8}"
                                                            Command="{Binding DataContext.WriteOtherPointAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="编辑" Style="{StaticResource SmallButton}"
                                                            Width="64" Height="38" Margin="{StaticResource GapRight8}"
                                                            Visibility="{Binding DataContext.EditableAddress, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.EditOtherPointAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="删除" Style="{StaticResource ButtonDanger}"
                                                            Width="64" Height="38"
                                                            Visibility="{Binding DataContext.EditableAddress, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DeleteOtherPointAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="其它点行根元素" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="其它点行根元素" Property="Background"
                                                        Value="{DynamicResource SurfaceAltBrush}" />
                                            </Trigger>
                                            <!-- 选中行高亮：与示教页 / 机种页的点位行同一视觉语言 -->
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="其它点行根元素" Property="Background"
                                                        Value="{DynamicResource PrimarySoftBrush}" />
                                                <Setter TargetName="其它点行点号" Property="Foreground"
                                                        Value="{DynamicResource PrimaryBrush}" />
                                                <Setter TargetName="其它点行点号" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="其它点行名称" Property="Foreground"
                                                        Value="{DynamicResource PrimaryBrush}" />
                                                <Setter TargetName="其它点行名称" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
