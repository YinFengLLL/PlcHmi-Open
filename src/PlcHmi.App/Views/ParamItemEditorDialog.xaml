<Window x:Class="PlcHmi.App.Views.ParameterEntryEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑参数条目"
        Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <TextBlock x:Name="PageHeaderText" Text="参数条目"
                       Style="{StaticResource DialogTitleText}" />
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                       Margin="{StaticResource GapTop8}" />
        </StackPanel>

        <!-- 名称 -->
        <StackPanel Grid.Row="1" Margin="{StaticResource GapBottom12}">
            <TextBlock Text="名称（可自定义）" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <TextBox x:Name="NameFrame" Style="{StaticResource InputBox}" MaxLength="20" />
        </StackPanel>

        <!-- 地址 -->
        <StackPanel Grid.Row="2" Margin="{StaticResource GapBottom12}">
            <TextBlock x:Name="AddressTag" Text="地址" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AddressFrame" Grid.Column="0" Style="{StaticResource InputBox}"
                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="12"
                         TextChanged="AddressManuallyModified" />
                <Button x:Name="选变量按钮" Grid.Column="2" Content="选变量…"
                        Style="{StaticResource SecondaryButton}" Height="44"
                        Click="AddressSelectVariable" />
            </Grid>
            <TextBlock x:Name="BindHintText" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                       Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <!-- 延时值 -->
        <Grid x:Name="ValueFaceBoard" Grid.Row="3" Margin="{StaticResource GapBottom12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="当前值" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
                <TextBox x:Name="ValueFrame" Style="{StaticResource InputBox}"
                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="10" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="单位" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
                <ComboBox x:Name="SingleBitFrame" Height="44" VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 取值范围 -->
        <Grid x:Name="RangeFaceBoard" Grid.Row="4" Margin="{StaticResource GapBottom12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="最小值" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
                <TextBox x:Name="MinValueFrame" Style="{StaticResource InputBox}"
                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="10" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="最大值" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
                <TextBox x:Name="MaxValueFrame" Style="{StaticResource InputBox}"
                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="10" />
            </StackPanel>
        </Grid>

        <!-- 启用 -->
        <CheckBox x:Name="EnabledFrame" Grid.Row="5" Content="启用该项目"
                  Margin="{StaticResource GapTop4}" VerticalAlignment="Center" />

        <TextBlock x:Name="MessageText" Grid.Row="6" VerticalAlignment="Top"
                   Text="" Foreground="{DynamicResource DangerBrush}"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="100" Height="44" Margin="{StaticResource GapRight12}" IsCancel="True" Click="Cancel" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}"
                    Width="110" Height="44" IsDefault="True" Click="Confirm" />
        </StackPanel>
    </Grid>
</Window>
