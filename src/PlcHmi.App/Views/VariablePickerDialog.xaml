<Window x:Class="PlcHmi.App.Views.VariableSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择变量"
        Height="620" Width="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom12}">
            <TextBlock x:Name="PageHeaderText" Text="从变量表选择变量"
                       Style="{StaticResource DialogTitleText}" />
            <TextBlock Text="选中变量后地址与数据类型自动回填；OPC UA 模式按变量名符号寻址"
                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <TextBox x:Name="SearchFrame" Grid.Row="1" Style="{StaticResource InputBox}"
                 Margin="{StaticResource GapBottom12}"
                 FontFamily="{StaticResource NumericFontFamily}"
                 TextChanged="SearchTextChanged" />

        <ListView x:Name="VariableList" Grid.Row="2"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                  SelectionMode="Single"
                  MouseDoubleClick="ListDoubleHit">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="变量名" Width="300"
                                    DisplayMemberBinding="{Binding VariableName}" />
                    <GridViewColumn Header="类型" Width="80"
                                    DisplayMemberBinding="{Binding TypeText}" />
                    <GridViewColumn Header="软元件地址" Width="110"
                                    DisplayMemberBinding="{Binding SoftElementAddress}" />
                    <GridViewColumn Header="注释" Width="200"
                                    DisplayMemberBinding="{Binding Comment}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource GapTop12}">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="100" Height="44" Margin="{StaticResource GapRight12}" IsCancel="True" Click="Cancel" />
            <Button Content="选定" Style="{StaticResource PrimaryButton}"
                    Width="110" Height="44" IsDefault="True" Click="Confirm" />
        </StackPanel>
    </Grid>
</Window>
