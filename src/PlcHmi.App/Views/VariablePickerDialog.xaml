<Window x:Class="上位机.应用.视图.变量选择对话框"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择变量"
        Height="620" Width="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom12}">
            <TextBlock x:Name="页眉文本" Text="从变量表选择变量"
                       Style="{StaticResource DialogTitleText}" />
            <TextBlock Text="选中变量后地址与数据类型自动回填；OPC UA 模式按变量名符号寻址"
                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <TextBox x:Name="搜索框" Grid.Row="1" Style="{StaticResource InputBox}"
                 Margin="{StaticResource GapBottom12}"
                 FontFamily="{StaticResource NumericFontFamily}"
                 TextChanged="搜索文本已变更" />

        <ListView x:Name="变量列表" Grid.Row="2"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                  SelectionMode="Single"
                  MouseDoubleClick="列表双击">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="变量名" Width="300"
                                    DisplayMemberBinding="{Binding 变量名}" />
                    <GridViewColumn Header="类型" Width="80"
                                    DisplayMemberBinding="{Binding 类型文本}" />
                    <GridViewColumn Header="软元件地址" Width="110"
                                    DisplayMemberBinding="{Binding 软元件地址}" />
                    <GridViewColumn Header="注释" Width="200"
                                    DisplayMemberBinding="{Binding 注释}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource GapTop12}">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="100" Height="44" Margin="{StaticResource GapRight12}" IsCancel="True" Click="取消" />
            <Button Content="选定" Style="{StaticResource PrimaryButton}"
                    Width="110" Height="44" IsDefault="True" Click="确认" />
        </StackPanel>
    </Grid>
</Window>
