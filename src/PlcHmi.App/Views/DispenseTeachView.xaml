<UserControl x:Class="上位机.应用.视图.点胶示教视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:上位机.应用.转换器"
             xmlns:views="clr-namespace:上位机.应用.视图"
             xmlns:svc="clr-namespace:上位机.应用.服务"
             xmlns:vm="clr-namespace:上位机.应用.视图模型"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:点胶示教视图模型}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:布尔可见性转换器 x:Key="BoolToVis" />

        <!-- 指令码下拉项：00 - 结束 … 09 - 对针（悬停提示码值，便于与 PLC 指令表对照） -->
        <DataTemplate x:Key="指令码项模板">
            <TextBlock Text="{Binding 显示}" ToolTip="{Binding 提示}" />
        </DataTemplate>

        <Style x:Key="TableCoordBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="2,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="点表行模板" DataType="{x:Type vm:点值行视图模型}">
            <Border x:Name="行根元素" Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    ToolTip="点击该行空白处选中此点位，「保存坐标点」会写入选中的点">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding 选中Command}" />
                </Border.InputBindings>
                <Grid Height="34" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="行标签" Grid.Column="0" Text="{Binding 标签}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding 单元格集合}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 指令码列只读显示文字（直线 / 刮胶 …）：选择入口在右侧「辅助地址」区首行的下拉框，
                                     选中即写 PLC，避免"手填数字"与"下拉选项"两个真相源 -->
                                <TextBox Text="{Binding 文本, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TableCoordBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding 是指令码}" Value="True">
                                                    <Setter Property="IsReadOnly" Value="True" />
                                                    <Setter Property="IsTabStop" Value="False" />
                                                    <Setter Property="TextAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="ToolTip"
                                                            Value="指令码在右侧「辅助地址」区首行的下拉框中选择（选中即写 PLC）" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="行根元素" Property="IsMouseOver" Value="True">
                    <Setter TargetName="行根元素" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding 是否当前}" Value="True">
                    <Setter TargetName="行根元素" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                    <Setter TargetName="行标签" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter TargetName="行标签" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding 有值}" Value="False">
                    <Setter TargetName="行标签" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}" Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom8}">
            <TextBlock Text="{Binding 标题}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding 副标题}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <!-- 序号 + 手动使能 + 地址编辑 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="{StaticResource ToolBarPadding}"
                Margin="{StaticResource GapBottom8}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▲" Style="{StaticResource SmallButton}" Width="42" Height="40"
                            Margin="{StaticResource GapRight4}" ToolTip="上一个点"
                            Command="{Binding 上一个序号Command}" />
                    <Border MinWidth="86" Height="40" CornerRadius="6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            Margin="{StaticResource GapRight4}">
                        <TextBlock Text="{Binding 序号摘要}" Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Content="▼" Style="{StaticResource SmallButton}" Width="42" Height="40"
                            Margin="{StaticResource GapRight12}" ToolTip="下一个点"
                            Command="{Binding 下一个序号Command}" />
                </StackPanel>

                <!-- 顶部固定状态灯（位置固定：与「手动使能」「编辑地址」同排居中，页与页之间不漂移）：
                     读指定 M 区位——0 = 各轴未回原（闪烁 + 提示），1 = 各轴回原完成（常亮）。
                     地址由管理员在「编辑地址」里配置，保存后 1 秒内即时生效。 -->
                <views:示教状态灯 Grid.Column="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{StaticResource GapRight8}" />

                <Border Grid.Column="2" Padding="{StaticResource ChipPadding}" CornerRadius="8"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="{StaticResource GapRight8}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="手动使能" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="{StaticResource GapRight8}" />
                        <CheckBox IsChecked="{Binding 是否手动启用}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 读取点表（2026-10-21 现场要求）：机种区段 D2500–D3999 不做周期采集，
                     点表现状必须由操作员显式读取，界面不再"跟着 PLC 实时变" -->
                <Button Grid.Column="3" Content="读取点表" Style="{StaticResource SecondaryButton}"
                        Width="110" Height="40" Margin="{StaticResource GapRight8}"
                        Command="{Binding 异步读取点表Command}"
                        ToolTip="从 PLC 读取本页点表全部点的当前值（只刷新界面，不写机种快照）" />

                <Button Grid.Column="4" Content="编辑地址" Style="{StaticResource SecondaryButton}"
                        Width="110" Height="40"
                        Visibility="{Binding 可编辑地址, Converter={StaticResource BoolToVis}}"
                        Command="{Binding 异步编辑地址Command}"
                        ToolTip="编辑本页所有与 PLC 交互的元件地址（仅管理员）" />
            </Grid>
        </Border>

        <!-- 主区：左点表，右动作指令 / 动作按钮 / 辅助地址 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" MinWidth="380" MaxWidth="620" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0"
                    MaxWidth="760" HorizontalAlignment="Stretch">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="{DynamicResource PrimarySoftBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="点号" Style="{StaticResource CaptionText}"
                                   FontWeight="SemiBold" Margin="20,8,0,8" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding 表定义.列}"
                                      Margin="0,0,20,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding 显示名称}" Style="{StaticResource CaptionText}"
                                               FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Margin="{StaticResource TableHeaderCellMargin}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding 行集合}" ItemTemplate="{StaticResource 点表行模板}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 右列三张卡片内容较多（动作指令 / 动作 / 辅助地址）：
                 整列套一个滚动条，保证任何窗口高度下都能看到全部内容；
                 辅助地址另有限高内滚动（条目可由管理员增删，长度不可预期）。 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="{StaticResource GapLeft12}">
                <StackPanel>

                <!-- 原第 1 张卡「动作指令」（提前关胶 / 运动速度延时 / 关胶后延时 / 抬针高度 /
                     点胶速度）已并入下方的「辅助地址」：那些参数本就是"名称 + 地址 + 数值"，
                     统一走辅助地址后，管理员可在地址编辑里改地址 / 类型 / 增删，
                     数值在本区直接读写 PLC，不再需要专用参数服务。 -->

                    <!-- 手动点动（统一形式）：上下左右箭头 + 中央档位切换；
                     保存坐标点 / 参数写入 / 清空当前点 随控件置于其下。
                     六轴共用同一个速度档位地址（现场要求，见 recipe-config 的 点动速度等级）。 -->
                <Border Style="{StaticResource CardBorder}" Padding="{StaticResource ToolBarPadding}"
                        Margin="{StaticResource GapBottom8}">
                    <StackPanel>
                        <!-- 本页各轴实时位置（点胶 3 轴：GlueX / Y / GlueZ，由点动分组驱动）；
                             点击选中轴 → 「轴回零」作用于选中轴 -->
                        <ItemsControl ItemsSource="{Binding 轴列表}" Margin="{StaticResource GapBottom8}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button MinWidth="96" Height="46" Margin="{StaticResource GapRight4}"
                                            Command="{Binding DataContext.选择轴Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding 是否选中}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding 名称}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding 位置文本}" HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource NumericFontFamily}"
                                                       FontSize="13" Opacity="0.9" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 主十字：上 Y− / 下 Y+ / 左 GlueX− / 右 GlueX+（点胶 Y 与锁附 Y 共轴） -->
                            <Button Grid.Row="0" Grid.Column="1" Content="Y−" Tag="Y,-1"
                                    Style="{StaticResource ButtonNeutral}" Height="54" Margin="2" FontSize="16"
                                    ToolTip="按住 Y 轴负向点动，松开立即停止" />
                            <Button Grid.Row="1" Grid.Column="0" Content="X−" Tag="GlueX,-1"
                                    Style="{StaticResource ButtonNeutral}" Height="54" Margin="2" FontSize="16"
                                    ToolTip="按住点胶 X 轴负向点动，松开立即停止" />
                            <Button Grid.Row="1" Grid.Column="1" Height="54" Margin="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding 异步切换档位Command}"
                                    ToolTip="切换点动档位（低=0 / 中=1 / 高=2），六轴共用同一档位地址">
                                <StackPanel>
                                    <TextBlock Text="档位" HorizontalAlignment="Center" FontSize="12" />
                                    <TextBlock Text="{Binding 档位文本}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="2" Content="X+" Tag="GlueX,1"
                                    Style="{StaticResource ButtonNeutral}" Height="54" Margin="2" FontSize="16"
                                    ToolTip="按住点胶 X 轴正向点动，松开立即停止" />
                            <Button Grid.Row="2" Grid.Column="1" Content="Y+" Tag="Y,1"
                                    Style="{StaticResource ButtonNeutral}" Height="54" Margin="2" FontSize="16"
                                    ToolTip="按住 Y 轴正向点动，松开立即停止" />

                            <!-- 点胶 Z 组：上 Z− / 下 Z+ -->
                            <Button Grid.Row="0" Grid.Column="3" Content="Z−" Tag="GlueZ,-1"
                                    Style="{StaticResource ButtonNeutral}" Height="54" Margin="2" FontSize="16"
                                    ToolTip="按住点胶 Z 轴负向点动，松开立即停止" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Z 轴" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="3" Content="Z+" Tag="GlueZ,1"
                                    Style="{StaticResource ButtonNeutral}" Height="54" Margin="2" FontSize="16"
                                    ToolTip="按住点胶 Z 轴正向点动，松开立即停止" />
                        </Grid>

                        <TextBlock Text="按住箭头点动对应轴，松开立即停止（上 Y− / 下 Y+ / 左 X− / 右 X+；Z 另一组上下箭头）。"
                                   Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />

                        <UniformGrid Columns="2" Margin="{StaticResource GapTop8}">
                            <Button Content="轴回零" Style="{StaticResource ButtonWarning}" Height="44"
                                    Margin="0,0,4,4" Command="{Binding 异步回零Command}"
                                    ToolTip="让选中轴回原点（只置位 M 区线圈，由 PLC 执行）" />
                            <Button Content="保存坐标点" Style="{StaticResource PrimaryButton}" Height="44"
                                    Margin="4,0,0,4" Command="{Binding 异步保存坐标点Command}"
                                    ToolTip="读取当前各轴位置并写入选中的点（需工程师及以上）" />
                            <Button Content="参数写入" Style="{StaticResource SecondaryButton}" Height="44"
                                    Margin="0,0,4,0" Command="{Binding 异步参数写入Command}"
                                    ToolTip="把上位机当前的 D2500–D3999 参数整段写入 PLC，并保存为当前机种（等同「下发机种 + 保存机种」）" />
                            <Button Content="清空当前点" Style="{StaticResource SmallButton}" Height="44"
                                    Margin="4,0,0,0" Command="{Binding 清空点Command}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 动作按钮 -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="{StaticResource ToolBarPadding}"
                            Margin="{StaticResource GapBottom8}">
                        <StackPanel>
                            <TextBlock Text="动作" Style="{StaticResource SectionTitleText}"
                                       Margin="{StaticResource GapBottom8}" />
                            <ItemsControl ItemsSource="{Binding 动作按钮集合}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 切换型动作按钮：首次按下置位（激活）、再次按下复位；
                                             激活时用成功色高亮，状态一眼可见（不再弹确认框） -->
                                        <!-- 首个固定按钮「参数模式」按 PLC 状态切换文字（0 默认参数 / 1 独立参数），
                                             其余按钮显示名称 -->
                                        <Button MinWidth="104" Height="42" Margin="0,0,10,10"
                                                Content="{Binding 显示名称}"
                                                ToolTip="{Binding 状态提示}"
                                                Command="{Binding DataContext.异步触发动作Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ButtonNeutral}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding 已激活}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="动作按钮为切换型：按一次置位（激活，按钮变绿），再按一次复位。只操作 M 区内部继电器，由 PLC 程序执行实际动作；未开启手动使能时会被拒绝。首个「参数模式」按钮读 M5006（可在「编辑地址」改）：0 = 默认参数、1 = 独立参数，状态实时回读 PLC。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="{StaticResource GapTop8}" />
                        </StackPanel>
                    </Border>

                    <!-- 辅助地址 -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="{StaticResource ToolBarPadding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="{StaticResource GapBottom8}">
                                <TextBlock Text="辅助地址" Style="{StaticResource SectionTitleText}"
                                           VerticalAlignment="Center" />
                                <Button Content="读取" Style="{StaticResource SmallButton}" Width="72" Height="34"
                                        HorizontalAlignment="Right"
                                        Command="{Binding 异步读取辅助地址值Command}" />
                            </Grid>

                            <!-- 指令码（辅助地址区首行，2026-10-21 现场要求）：
                                 选中一个点后在此选择 00 结束 … 09 对针，选中即写该点的指令码字
                                 （第 n 点 = D3400 + n - 1；例：第 2 点选「直线」→ D3401 = 2），
                                 点表「指令码」列同步显示对应文字。锁附页无指令码列，整块隐藏。 -->
                            <Border DockPanel.Dock="Top"
                                    Margin="{StaticResource GapBottom8}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Visibility="{Binding 含指令码, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="{StaticResource GapBottom8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="指令码" Style="{StaticResource BodyText}"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding 指令码地址文本}"
                                                   Style="{StaticResource CaptionText}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" Height="38" VerticalAlignment="Center"
                                              ItemsSource="{Binding 指令码选项}"
                                              SelectedItem="{Binding 选中指令码项, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource 指令码项模板}"
                                              ToolTip="选择后立即写入当前点的指令码寄存器，并在点表「指令码」列显示文字" />
                                </Grid>
                            </Border>

                            <!-- 单点工艺参数是结构体数组：地址随选中点偏移，必须明确"现在改的是第几点"，
                                 否则所有点的字段名一模一样，很容易改错点（2026-10-21 现场要求）。
                                 摘要为空（固定地址页）时用触发器折叠，不占位。 -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding 辅助地址摘要}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource GapBottom8}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding 辅助地址摘要}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock DockPanel.Dock="Bottom"
                                       Text="数值填完按回车（或点别处）即写入 PLC，并实时显示 PLC 现值；未开手动使能时只能查看。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Margin="{StaticResource GapTop8}" />

                            <!-- 行数不定（管理员可增删）：限高 + 内滚动，超出的条目可滑动查看 -->
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding 辅助地址集合}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 实时读写（2026-11-12）：值随 PLC 周期回读，填完回车 / 点别处即写入；
                                             不再有「写入」按钮。未开手动使能时整行置灰（只能看不能改）。 -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding 名称}" Style="{StaticResource BodyText}"
                                                           FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding 地址文本}" Style="{StaticResource CaptionText}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                                     VerticalContentAlignment="Center" Height="36"
                                                     FontFamily="{StaticResource NumericFontFamily}" MaxLength="12"
                                                     Visibility="{Binding 是数值, Converter={StaticResource BoolToVis}}"
                                                     IsEnabled="{Binding 可编辑}"
                                                     ToolTip="{Binding 输入提示}"
                                                     svc:输入提交手势.附加="True"
                                                     Text="{Binding 文本, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Visibility="{Binding 是开关, Converter={StaticResource BoolToVis}}"
                                                      IsEnabled="{Binding 可编辑}"
                                                      ToolTip="{Binding 输入提示}"
                                                      IsChecked="{Binding 开关状态}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
