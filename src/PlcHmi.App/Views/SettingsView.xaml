<UserControl x:Class="PlcHmi.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PlcHmi.App.Converters"
             xmlns:vm="clr-namespace:PlcHmi.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:ResourceKeyBrushConverter x:Key="KeyToBrush" />
        <conv:BooleanVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}"
          Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 连接状态 -->
        <Grid Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
            </StackPanel>

            <Border Grid.Column="1" Padding="{StaticResource ToolBarPadding}" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource StatusDot}"
                             Fill="{Binding ConnectionStateColorKey, Converter={StaticResource KeyToBrush}}"
                             Margin="{StaticResource GapRight12}" />
                    <TextBlock Text="{Binding ConnectionStateText}" Style="{StaticResource BodyText}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 运行模式提示 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="{StaticResource ToolBarPadding}" Margin="{StaticResource GapBottom16}"
                Background="{DynamicResource PrimarySoftBrush}"
                BorderBrush="{DynamicResource PrimaryLightBrush}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource PrimaryBrush}"
                         Margin="{StaticResource GapRight12}" />
                <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center">
                    <Run Text="当前运行模式：" />
                    <Run Text="{Binding ModeText, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryBrush}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 配置区。首屏聚焦"当前配置"（只读摘要），管理员编辑拆为下方独立卡（P3 聚焦性）；
             内容超过一屏时允许滚动，否则按钮会被裁掉 -->
        <ScrollViewer PanningMode="VerticalOnly" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <!-- 底部留白：滚到底时最后一张卡不会贴着视口边缘（触屏滚动尤其明显） -->
            <Grid Margin="{StaticResource GapBottom16}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- 通信配置（只读摘要 + 测试连接） -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="{StaticResource GapRight8}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="{StaticResource GapBottom16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="通信配置" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        <!-- 测试连接与通信配置同卡就近（原先在页面右下角，动线割裂） -->
                        <Button Content="测试连接" Style="{StaticResource SecondaryButton}"
                                Width="130" Height="44" HorizontalAlignment="Right"
                                ToolTip="按当前生效参数尝试建立一次连接"
                                Command="{Binding TestConnectCommand}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC 地址" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Host}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Port}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="从站号 UnitId" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UnitId}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="机型系列" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SeriesText}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="连接超时" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConnectTimeoutText}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="读写超时" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReadTimeoutText}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="心跳间隔" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HeartbeatText}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="自动重连" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AutoReconnectText}" Style="{StaticResource BodyText}"
                                   Margin="{StaticResource GapV8}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 采集配置 -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="{StaticResource GapLeft8}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="采集配置" Style="{StaticResource SectionTitleText}" Margin="{StaticResource GapBottom16}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="快速组周期" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}"
                                   ToolTip="轴位置、速度等需要高速刷新的点位按此周期轮询" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FastIntervalText}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="慢速组周期" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}"
                                   ToolTip="温度、计数等变化缓慢的点位按此周期轮询" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SlowIntervalText}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="事件组周期" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}"
                                   ToolTip="报警位等需要尽快响应的点位按此周期轮询" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EventIntervalText}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="单次最大寄存器" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV8}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MaxRegisterText}" Style="{StaticResource BodyText}"
                                   FontFamily="{StaticResource NumericFontFamily}" Margin="{StaticResource GapV8}" />
                    </Grid>

                    <Separator Margin="{StaticResource GapV12}" Background="{DynamicResource BorderBrush}" />

                    <TextBlock Text="现场说明" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="{StaticResource GapBottom8}" />
                    <TextBlock Text="{Binding BackupNoteText}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
            </Border>

            <!-- ══ 连接参数编辑（独立卡，仅管理员）═══════════════════════
                 从通信配置卡拆出：只读摘要与管理员表单不再挤在同一张卡里。
                 保存走服务层校验 + 原子落盘 + 断开重连，立即生效；
                 机型系列与运行模式刻意不给改：换机型属高风险 L3。 -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}"
                    Margin="{StaticResource GapTop16}" VerticalAlignment="Top"
                    Visibility="{Binding EditableConnect, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="连接参数编辑（管理员）" Style="{StaticResource SectionTitleText}"
                               Margin="{StaticResource GapBottom4}" />
                    <TextBlock Text="保存后立即断开并用新参数重连（几秒内恢复），同时写入 config/appsettings.json；机型系列不可在线更改，运行模式改用下方独立卡片切换。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="{StaticResource GapBottom12}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC 地址" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditHost}"
                                 Margin="{StaticResource GapV4}" ToolTip="PLC 的 IP 地址或主机名" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditPort}"
                                 Margin="{StaticResource GapV4}" ToolTip="Modbus TCP 端口，1–65535，标准 502" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="从站号 UnitId" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditUnitId}"
                                 Margin="{StaticResource GapV4}" ToolTip="Modbus 从站号，1–247" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="连接超时 ms" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditConnectTimeout}"
                                 Margin="{StaticResource GapV4}" ToolTip="建立 TCP 连接的超时，≥100" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="读写超时 ms" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditReadTimeout}"
                                 Margin="{StaticResource GapV4}" ToolTip="单次读写的超时，≥100" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="心跳间隔 ms" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditHeartbeat}"
                                 Margin="{StaticResource GapV4}" ToolTip="链路探活周期，≥500，过密会占用 PLC 连接能力" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="重连初始 ms" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditReconnectInitial}"
                                 Margin="{StaticResource GapV4}" ToolTip="断线后首次重试的等待时间，≥100" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="重连上限 ms" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditReconnectMax}"
                                 Margin="{StaticResource GapV4}" ToolTip="指数退避的上限，不能小于重连初始" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="单次最大寄存器" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditMaxRegister}"
                                 Margin="{StaticResource GapV4}" ToolTip="1–123，汇川读上限 123（建议保守取 100）" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="自动重连" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding EditAutoReconnect}"
                                  Margin="{StaticResource GapV4}" VerticalAlignment="Center"
                                  ToolTip="断线后自动按指数退避重连；关闭后断线将进入故障态并停止重试" />

                        <!-- 通讯模式：协议由 DI 装配定型，保存后需重启程序生效 -->
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="通讯模式" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="10" Grid.Column="1" Height="40" VerticalContentAlignment="Center"
                                  Margin="{StaticResource GapV4}"
                                  ItemsSource="{Binding ProtocolOptions}"
                                  SelectedIndex="{Binding EditProtocolIndex}"
                                  ToolTip="Modbus TCP / OPC UA。协议由程序装配定型：保存写入配置，重启程序后生效；OPC UA 模式下元件按变量名符号寻址" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="OPC UA 端口" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditOpcUaPort}"
                                 Margin="{StaticResource GapV4}" ToolTip="OPC UA 服务端端口，1–65535，汇川内置服务端默认 4840（仅 OPC UA 模式使用）" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="OPC UA 命名空间" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditNamespace}"
                                 Margin="{StaticResource GapV4}" ToolTip="NodeId 的 ns= 索引，默认 2（与汇川软元件节点所在命名空间一致）" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="模拟从站端口" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="13" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditSimulationSlavePort}"
                                 Margin="{StaticResource GapV4}" ToolTip="模拟运行模式下，供 Modbus 工具离线调试的从站端口，默认 5020（避开真实 PLC 的 502）" />

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="模拟从站监听地址" Style="{StaticResource CaptionText}" Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="14" Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EditSimulationSlaveListenAddress}"
                                 Margin="{StaticResource GapV4}" ToolTip="默认 127.0.0.1（仅本机）；跨机调试填 0.0.0.0 或本机网卡地址" />
                    </Grid>

                    <Button Content="保存并生效" Style="{StaticResource PrimaryButton}"
                            Width="140" Height="44" HorizontalAlignment="Left"
                            Margin="{StaticResource GapTop12}"
                            Command="{Binding SaveConnectAsyncCommand}" />
                </StackPanel>
            </Border>

            <!-- ══ 运行模式（仅 Modbus 模式、仅管理员）═══════════════════════
                 运行期在「真实 PLC / 模拟 PLC」之间切换，无需重启；
                 切换不跨重启记忆，重启即回真实 PLC。模拟模式下开放本地 Modbus 从站供工具离线调试。 -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}"
                    Margin="{StaticResource GapTop16}" VerticalAlignment="Top"
                    Visibility="{Binding SwitchableRunMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="运行模式（管理员）" Style="{StaticResource SectionTitleText}"
                               Margin="{StaticResource GapBottom4}" />
                    <TextBlock Text="{Binding RunModeDescription}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="{StaticResource GapBottom12}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前模式" Style="{StaticResource CaptionText}"
                                   Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RunModeText}"
                                   Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                   Margin="{StaticResource GapV4}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="切换到" Style="{StaticResource CaptionText}"
                                   Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Height="40" VerticalContentAlignment="Center"
                                  Margin="{StaticResource GapV4}"
                                  ItemsSource="{Binding RunModeOptions}"
                                  SelectedIndex="{Binding EditRunModeIndex}"
                                  ToolTip="选择目标运行模式后点右侧按钮切换" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="模拟从站" Style="{StaticResource CaptionText}"
                                   Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}"
                                   Margin="{StaticResource GapV4}" VerticalAlignment="Center">
                            <Run Text="{Binding SimulationSlaveStateText, Mode=OneWay}" />
                            <Run Text="　" />
                            <Run Text="{Binding SimulationSlaveEndpointText, Mode=OneWay}"
                                 FontFamily="{StaticResource NumericFontFamily}" />
                        </TextBlock>
                    </Grid>

                    <Button Content="切换运行模式" Style="{StaticResource PrimaryButton}"
                            Width="140" Height="44" HorizontalAlignment="Left"
                            Margin="{StaticResource GapTop12}"
                            Command="{Binding SwitchRunModeAsyncCommand}" />
                </StackPanel>
            </Border>

            <!-- ══ 汇川变量表（独立卡，仅管理员可导入）═══════════════════
                 导入 AutoShop 变量表 CSV 后，轴参数 / 延时 / 气缸等配置
                 可按变量名绑定点位；OPC UA 模式直接以变量名符号寻址。 -->
            <!-- ══ 弹窗设置（独立卡，仅管理员）═══════════════════
                 可配置弹窗：M 区触发地址闭合即显示（断开即消失），两颗复归型按钮各对应一个 M 线圈。 -->
            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}"
                    Margin="{StaticResource GapTop16}" VerticalAlignment="Top"
                    Visibility="{Binding EditableConnect, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="弹窗设置（管理员）" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="配置主界面弹窗：M 区触发地址闭合（ON）居中显示、断开（OFF）立即消失；"
                                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
                            <TextBlock Text="弹窗内容与两个按钮名称可自定义，按钮为复归型（按住置位、松开复位对应 M 线圈）。"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="弹窗设置…" Style="{StaticResource SecondaryButton}"
                                Width="130" Height="44" VerticalAlignment="Top"
                                ToolTip="新增 / 编辑可配置弹窗（仅管理员）"
                                Command="{Binding PopupSetAsyncCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}"
                    Margin="{StaticResource GapTop16}" VerticalAlignment="Top">
                <StackPanel>
                    <!-- 必须显式给出两列：原先没有 ColumnDefinitions，左右两个 StackPanel
                         都落在同一列上互相重叠，卡片就成了"显示不全" -->
                    <Grid Margin="{StaticResource GapBottom12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="汇川变量表" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="导入 AutoShop 导出的变量表 CSV（config/variables.json）；"
                                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
                            <TextBlock Text="轴参数 / 延时 / 气缸配置即可用「选变量…」绑定，Modbus 按映射地址通讯，OPC UA 按变量名寻址。"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="{Binding VariableTableEntryNumberText, FallbackValue=0 eachRow}"
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                       Margin="{StaticResource GapRight12}" />
                            <Button Content="浏览变量" Style="{StaticResource SecondaryButton}"
                                    Width="110" Height="44" Margin="{StaticResource GapRight12}"
                                    Command="{Binding CheckSeeVariableTableCommand}" />
                            <Button Content="导入 CSV…" Style="{StaticResource SecondaryButton}"
                                    Width="130" Height="44"
                                    Command="{Binding ImportVariableTableAsyncCommand}"
                                    Visibility="{Binding ImportableVariableTable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ 外观（所有身份可见）═════════════════════════════════
                 深浅主题切换：立即生效（整体替换调色板字典）并写入
                 config/appsettings.json，重启后保持。属显示偏好而非设备参数，
                 因此不设权限、不做二次确认。 -->
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}"
                    Margin="{StaticResource GapTop16}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitleText}"
                               Margin="{StaticResource GapBottom4}" />
                    <TextBlock Text="深色主题适合主控室 / 车间暗环境长时间监控；切换立即生效并写入配置，重启后保持。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="{StaticResource GapBottom12}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="界面主题" Style="{StaticResource CaptionText}"
                                   Margin="{StaticResource GapV4}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Height="40" VerticalContentAlignment="Center"
                                  Margin="{StaticResource GapV4}"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  ToolTip="深色 / 浅色主题，选择后立即生效" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ 扫码枪设置（独立卡，2026-11-12；仅管理员可改）═══════════ -->
            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource CardBorder}" Margin="{StaticResource GapTop16}"
                    Visibility="{Binding ShowScannerSet, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding ScannerSettings}">
                    <Grid Margin="{StaticResource GapBottom12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="扫码枪设置（管理员）"
                                   Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="{StaticResource GapLeft16}">
                            <TextBlock Text="{Binding ConnectionStateText}" FontWeight="SemiBold"
                                       Foreground="{Binding ConnectionStateColorKey, Converter={StaticResource KeyToBrush}}" />
                            <TextBlock Text="　工单号：" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WorkOrderText}" FontFamily="{StaticResource NumericFontFamily}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="重新连接" Style="{StaticResource SmallButton}"
                                Height="34" Margin="{StaticResource GapRight8}"
                                Command="{Binding ReconnectAsyncCommand}"
                                ToolTip="按当前配置重新打开串口 / 重连 TCP（扫码枪拔插或重启后使用）" />

                        <Button Grid.Column="3" Content="保存扫码枪设置" Style="{StaticResource PrimaryButton}"
                                Height="34" Padding="16,0"
                                IsEnabled="{Binding EditableScanner}"
                                Command="{Binding SaveAsyncCommand}" />
                    </Grid>

                    <WrapPanel>
                        <CheckBox Content="启用扫码" VerticalAlignment="Center" Margin="{StaticResource GapRight16}"
                                  IsEnabled="{Binding EditableScanner}"
                                  IsChecked="{Binding Enabled}"
                                  ToolTip="未启用时不打开串口/网口，也不写任何寄存器" />

                        <TextBlock Text="通讯模式" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="{StaticResource GapRight4}" />
                        <ComboBox Width="150" Height="36" VerticalContentAlignment="Center"
                                  IsEnabled="{Binding EditableScanner}"
                                  ItemsSource="{Binding CommunicationModeOptions}"
                                  SelectedIndex="{Binding CommunicationModeIndex}" />

                        <TextBlock Text="扫码模式" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <ComboBox Width="130" Height="36" VerticalContentAlignment="Center"
                                  IsEnabled="{Binding EditableScanner}"
                                  ItemsSource="{Binding WorkModeOptions}"
                                  SelectedIndex="{Binding WorkModeIndex}"
                                  ToolTip="手动型：收到扫码结果即写成功信号；触发型：PLC 置位触发寄存器 → 上位机写 0 应答并等码，超时未扫到写 2（失败）" />
                    </WrapPanel>

                    <!-- 串口参数（TCP 模式隐藏） -->
                    <WrapPanel Margin="{StaticResource GapTop8}"
                               Visibility="{Binding IsSerialPortMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="串口号" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="{StaticResource GapRight4}" />
                        <ComboBox Width="110" Height="36" IsEditable="True"
                                  IsEnabled="{Binding EditableScanner}"
                                  ItemsSource="{Binding AvailableSerialPort}"
                                  Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="下拉选本机已检测到的串口，也可直接输入（如 COM3）" />
                        <Button Content="刷新" Style="{StaticResource SmallButton}"
                                Height="36" Padding="10,0" Margin="{StaticResource GapLeft8}"
                                IsEnabled="{Binding EditableScanner}"
                                Command="{Binding RefreshSerialPortCommand}"
                                ToolTip="重新枚举本机串口（USB 转串口拔插后点一下）" />

                        <TextBlock Text="波特率" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <TextBox Width="100" Height="36" Style="{StaticResource InputBox}"
                                 Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="数据位" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <ComboBox Width="80" Height="36" VerticalContentAlignment="Center"
                                  IsEnabled="{Binding EditableScanner}"
                                  ItemsSource="{Binding DataBitOptions}"
                                  SelectedIndex="{Binding DataBitIndex}" />

                        <TextBlock Text="停止位" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <ComboBox Width="80" Height="36" VerticalContentAlignment="Center"
                                  IsEnabled="{Binding EditableScanner}"
                                  ItemsSource="{Binding StopBitsOptions}"
                                  SelectedIndex="{Binding StopBitsIndex}" />

                        <TextBlock Text="校验" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <ComboBox Width="80" Height="36" VerticalContentAlignment="Center"
                                  IsEnabled="{Binding EditableScanner}"
                                  ItemsSource="{Binding ValidateOptions}"
                                  SelectedIndex="{Binding ValidateIndex}" />
                    </WrapPanel>

                    <!-- 网口参数（串口模式隐藏） -->
                    <WrapPanel Margin="{StaticResource GapTop8}"
                               Visibility="{Binding IsEthernetMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="扫码枪 IP" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="{StaticResource GapRight4}" />
                        <TextBox Width="160" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 Text="{Binding EthernetAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="扫码枪侧需配成 TCP Server，上位机作为客户端连接" />

                        <TextBlock Text="端口" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <TextBox Width="100" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 Text="{Binding EthernetPort, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>

                    <!-- 与 PLC 的握手信号 -->
                    <WrapPanel Margin="{StaticResource GapTop12}">
                        <TextBlock Text="扫码成功信号寄存器" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="{StaticResource GapRight4}" />
                        <TextBox Width="100" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 FontFamily="{StaticResource NumericFontFamily}"
                                 Text="{Binding ScanSuccessRegister, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="扫码成功由上位机写 1；触发型超时未扫到写 2（D 区单字，默认 D4050）" />

                        <TextBlock Text="扫码触发寄存器" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <TextBox Width="100" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 FontFamily="{StaticResource NumericFontFamily}"
                                 Text="{Binding ScanTriggerRegister, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="触发型：PLC 置 1 请求扫码，上位机写 0 应答（默认 D4010）" />
                    </WrapPanel>

                    <!-- 指令码与超时（触发型） -->
                    <WrapPanel Margin="{StaticResource GapTop8}">
                        <TextBlock Text="触发指令" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="{StaticResource GapRight4}" />
                        <TextBox Width="110" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 Text="{Binding TriggerCommand, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="触发型检测到 PLC 触发后下发给扫码枪（默认 TRIGGER）。扫码枪不需要指令就清空" />

                        <TextBlock Text="释放指令" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <TextBox Width="110" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 Text="{Binding ReleaseCommand, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="触发型本次扫码结束（扫到或超时）后下发（默认 RELEASE）。扫码枪不需要指令就清空" />

                        <TextBlock Text="触发轮询间隔（ms）" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <TextBox Width="90" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 Text="{Binding PollingIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- 2026-11-12 现场要求：触发后多久没扫到就判失败 -->
                        <TextBlock Text="扫码超时（ms）" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,4,0" />
                        <TextBox Width="90" Height="36" Style="{StaticResource InputBox}"
                                 IsEnabled="{Binding EditableScanner}"
                                 Text="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="触发型：PLC 触发后超过这个时间还没收到条码，就判本次扫码失败——写扫码成功信号寄存器 = 2 并下发释放指令（默认 5000）" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="{StaticResource GapTop8}"
                               Text="手动型：扫码枪扫到码即视为成功（写成功信号寄存器 = 1），不看触发寄存器。触发型：PLC 把触发寄存器置 1 → 上位机写 0 应答并下发触发指令 → 等码；超时时间内扫到写 1（成功），超时未扫到写 2（失败）并下发释放指令，同一件后续再收到的条码会被忽略（需重新触发）。工单号只保存在本机内存，关闭软件即清空。" />
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Grid Grid.Row="3" Margin="{StaticResource GapTop16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="只读参数来自 config/appsettings.json；管理员可在上方「连接参数编辑」卡片在线修改，保存后立即生效。"
                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="{StaticResource GapRight12}" />
        </Grid>
    </Grid>
</UserControl>
