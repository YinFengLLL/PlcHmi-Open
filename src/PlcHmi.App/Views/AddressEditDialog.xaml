<Window x:Class="PlcHmi.App.Views.AddressEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PlcHmi.App.Converters"
        Title="地址编辑"
        Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Window.Resources>
        <conv:BooleanVisibilityConverter x:Key="BoolToVis" />

        <CollectionViewSource x:Key="GroupView" Source="{Binding RowCollection}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom12}">
            <TextBlock x:Name="TitleWidget" Style="{StaticResource DialogTitleText}" />
            <TextBlock Text="页面上所有与 PLC 交互的元件地址都可在此修改：点表列基址、辅助地址、动作按钮、点动与回零线圈、顶部状态灯。地址改动保存后立即生效，请先确认 PLC 侧已同步改好。"
                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop8}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource GapBottom8}">
                <Button Content="＋ 新增辅助地址" Style="{StaticResource SecondaryButton}"
                        Width="164" Height="40" Margin="{StaticResource GapRight8}"
                        Click="AddAuxAddress" />
                <Button Content="＋ 新增动作按钮" Style="{StaticResource SecondaryButton}"
                        Width="164" Height="40" Margin="{StaticResource GapRight8}"
                        Click="AddActionButton" />
                <TextBlock Text="辅助地址与动作按钮可由管理员新增 / 删除；点表列、点动、回零、状态灯为固定元件，可改地址不可删（状态灯地址须为 M 区，如 M465）。点胶页的辅助地址可勾选「结构体成员」——保存时按成员顺序与数据类型重排偏移与结构体长度。"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupView}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PrimarySoftBrush}" Padding="12,6">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource CaptionText}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid Height="46" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 名称：辅助地址 / 动作按钮是管理员自定义条目，可改名；
                                             点表列 / 点动 / 回零的名称由配置派生（保存时也不回写），保持只读 -->
                                        <TextBox Grid.Column="0"
                                                 VerticalContentAlignment="Center"
                                                 MaxLength="16"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                                    <!-- 辅助地址 / 动作按钮是管理员自定义条目，可改名；
                                                         点表列 / 点动 / 回零的名称由配置派生（保存不回写），只读 -->
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="辅助地址">
                                                            <Setter Property="IsEnabled" Value="True" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="动作按钮">
                                                            <Setter Property="IsEnabled" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- 结构体成员的地址由「基址 + 点序号 × 长度 + 偏移」算出，这里只显示不可改 -->
                                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                                 VerticalContentAlignment="Center"
                                                 FontFamily="{StaticResource NumericFontFamily}"
                                                 MaxLength="12"
                                                 IsEnabled="{Binding AddressEditable}"
                                                 ToolTip="结构体成员的地址由 基址 + 点序号 × 长度 + 偏移 自动计算（保存后重排），不能手改"
                                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}" />

                                        <ComboBox Grid.Column="3" VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding TypeOptions}"
                                                  IsEnabled="{Binding CanChangeType}"
                                                  SelectedItem="{Binding DataTypeText, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="数据类型（仅辅助地址可改；动作按钮是 M 区线圈）。改类型会改变结构体成员的占用字数，保存后偏移与长度自动重排" />

                                        <!-- 结构体成员（仅点胶页辅助地址显示）：勾选即按结构体数组寻址 -->
                                        <CheckBox Grid.Column="4" Content="结构体成员" FontSize="12"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding StructMember, Mode=TwoWay}"
                                                  Visibility="{Binding SettableStructMember, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="勾选后该参数按结构体数组寻址：地址 = 基址 + 点序号 × 长度 + 成员偏移。保存时按成员顺序与数据类型重排偏移和长度（例如把抬针高度改成 INT16，后面的点胶速度会前移到 D3505）" />

                                        <Button Grid.Column="5" Content="删除"
                                                Style="{StaticResource ButtonDanger}"
                                                Width="64" Height="34" Margin="{StaticResource GapLeft8}"
                                                Visibility="{Binding Deletable, Converter={StaticResource BoolToVis}}"
                                                Click="DeleteRow" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <TextBlock x:Name="MessageText" Grid.Row="2" Text=""
                   Foreground="{DynamicResource DangerBrush}"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="{StaticResource GapTop8}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource GapTop12}">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="100" Height="44" Margin="{StaticResource GapRight12}"
                    IsCancel="True" Click="Cancel" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                    Width="120" Height="44" IsDefault="True" Click="Confirm" />
        </StackPanel>
    </Grid>
</Window>
