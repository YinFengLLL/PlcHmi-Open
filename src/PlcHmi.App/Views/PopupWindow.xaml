<Window x:Class="PlcHmi.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindow}">

    <!-- 与登录界面同一套窗口参数：固定宽度 + SizeToContent="Height" + CenterOwner，
         内容多长窗口就多高，永远完整可见、始终居中，不会出现"卡片被行高裁掉"的问题 -->
    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <TextBlock Text="{Binding Name}" Style="{StaticResource DialogTitleText}"
                       TextWrapping="Wrap" />
            <TextBlock Text="设备提示 · 由 PLC 触发" Style="{StaticResource CaptionText}"
                       Margin="{StaticResource GapTop8}" />
        </StackPanel>

        <!-- 内容（自定义文案，长文本自动换行） -->
        <TextBlock Grid.Row="1" Text="{Binding Content}"
                   Style="{StaticResource BodyText}" FontSize="16"
                   TextWrapping="Wrap"
                   Margin="{StaticResource GapBottom20}" />

        <!-- 两颗按钮：模式（复归型 / 置位 ON / 复位 OFF）由管理员在弹窗设置里配，
             提示文案随模式变化；按下即写入，复归型额外在松开时复位（手势在代码隐藏里接） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Button1" MinWidth="140" Height="48"
                    Style="{StaticResource PrimaryButton}"
                    Margin="{StaticResource GapRight12}"
                    Content="{Binding Button1Name}"
                    ToolTip="{Binding Button1ModeDescription}" />

            <Button x:Name="Button2" MinWidth="140" Height="48"
                    Content="{Binding Button2Name}"
                    ToolTip="{Binding Button2ModeDescription}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <!-- 按钮二名称未配置时整颗隐藏（单按钮弹窗） -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Button2Name}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Button2Name}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
