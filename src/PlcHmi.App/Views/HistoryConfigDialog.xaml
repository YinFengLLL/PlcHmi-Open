<Window x:Class="PlcHmi.App.Views.HistoryConfigEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑历史记录配置"
        Width="960" SizeToContent="Height" MaxHeight="820"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom16}">
            <TextBlock Text="数据体配置" Style="{StaticResource DialogTitleText}" />
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="{StaticResource GapTop8}"
                       Text="上位机监测触发位，出现一次上升沿（0 → 1）就把下面各地址的值读回来，记成一行历史数据。" />
        </StackPanel>

        <!-- 数据体名称 / 触发位 / 保留天数 -->
        <Grid Grid.Row="1" Margin="{StaticResource GapBottom12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="数据体名称" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
                <TextBox x:Name="NameFrame" Style="{StaticResource InputBox}" MaxLength="20" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="触发位（M 区）" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TriggerBitFrame" Style="{StaticResource InputBox}"
                             FontFamily="{StaticResource NumericFontFamily}" MaxLength="12" />
                    <Button Grid.Column="1" Content="选变量…" Style="{StaticResource SecondaryButton}"
                            Height="44" Margin="{StaticResource GapLeft8}"
                            ToolTip="从变量表挑一个变量填入触发位"
                            Click="TriggerBitSelectVariable" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="保留天数" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
                <TextBox x:Name="RetainDaysNumberFrame" Style="{StaticResource InputBox}"
                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="4" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="{StaticResource GapBottom16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="EnabledFrame" Content="启用采集（停用后不再记录新数据）"
                      MinHeight="32" VerticalAlignment="Center" />

            <CheckBox x:Name="ResetFrame" Grid.Column="2" Content="读取完成后自动复位触发位"
                      MinHeight="32" VerticalAlignment="Center"
                      ToolTip="与 PLC 的握手：PLC 置位 → 上位机读走数据 → 上位机把触发位写回 0。若 PLC 程序自己清位，请取消勾选" />
        </Grid>

        <!-- 数据项 -->
        <Grid Grid.Row="3" Margin="{StaticResource GapBottom8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="数据项（表格的列）" Style="{StaticResource SectionTitleText}" />
                <TextBlock x:Name="DataItemSummaryText" Style="{StaticResource CaptionText}"
                           Margin="{StaticResource GapTop4}" />
            </StackPanel>

            <Button Grid.Column="1" Content="＋ 新增数据项" Style="{StaticResource SecondaryButton}"
                    Height="44" VerticalAlignment="Top"
                    ToolTip="在数据体末尾追加一列"
                    Click="AddDataItem" />
        </Grid>

        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
            <DockPanel>
                <!-- 表头 -->
                <Grid DockPanel.Dock="Top" Background="{DynamicResource PrimarySoftBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}" />
                    <TextBlock Grid.Column="1" Text="地址" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}" />
                    <TextBlock Grid.Column="2" Text="数值类型" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}" />
                    <TextBlock Grid.Column="3" Text="小数位" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}" />
                    <TextBlock Grid.Column="4" Text="单位" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}" />
                    <TextBlock Grid.Column="5" Text="ASCII" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}"
                               ToolTip="勾选后按字符显示（仅 DINT：4 字节 = 4 个字符），用于读批次号 / 产品码这类打包字符" />
                    <TextBlock Grid.Column="6" Text="颜色" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMargin}"
                               ToolTip="给这一列标红 / 黄 / 绿，表格与表头文字按此着色" />
                    <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="{StaticResource TableHeaderCellMarginLast}" />
                </Grid>

                <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              MaxHeight="320" HorizontalContentAlignment="Stretch">
                    <ItemsControl x:Name="DataItemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="{StaticResource GapV4}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                                 Margin="{StaticResource GapRight8}"
                                                 MaxLength="16"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid Grid.Column="1" Margin="{StaticResource GapRight8}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource InputBox}"
                                                     FontFamily="{StaticResource NumericFontFamily}"
                                                     MaxLength="12"
                                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="…" Style="{StaticResource IconButton}"
                                                    Margin="{StaticResource GapLeft4}"
                                                    ToolTip="从变量表挑一个变量填入地址"
                                                    Click="DataItemSelectVariable" />
                                        </Grid>

                                        <ComboBox Grid.Column="2" Height="44" VerticalContentAlignment="Center"
                                                  Margin="{StaticResource GapRight8}"
                                                  ItemsSource="{Binding DataTypeOptions}"
                                                  SelectedIndex="{Binding TypeIndex, Mode=TwoWay}" />

                                        <ComboBox Grid.Column="3" Height="44" VerticalContentAlignment="Center"
                                                  Margin="{StaticResource GapRight8}"
                                                  IsEnabled="{Binding DecimalBitAvailable}"
                                                  ItemsSource="{Binding DecimalBitOptions}"
                                                  SelectedIndex="{Binding DecimalBitIndex, Mode=TwoWay}"
                                                  ToolTip="INT / DINT：显示值 = PLC 原始值 ÷ 10 的小数位次方（填 2 时 600 显示为 6.00）。REAL（32 位浮点）：原始值已是工程量，小数位只决定保留几位（填 2 时 12.3456 显示为 12.35）。ASCII 显示时不参与" />

                                        <TextBox Grid.Column="4" Style="{StaticResource InputBox}"
                                                 Margin="{StaticResource GapRight8}"
                                                 MaxLength="6"
                                                 Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Grid.Column="5" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsEnabled="{Binding SettableAscii}"
                                                  IsChecked="{Binding ShowAsAscii, Mode=TwoWay}"
                                                  ToolTip="按 ASCII 字符显示（仅 DINT：4 字节 = 4 个字符）。PLC 把批次号 / 产品码这类字符打包进寄存器时勾选" />

                                        <ComboBox Grid.Column="6" Height="44" VerticalContentAlignment="Center"
                                                  Margin="{StaticResource GapRight8}"
                                                  ItemsSource="{Binding ColorOptionsTable}"
                                                  SelectedIndex="{Binding ColorIndex, Mode=TwoWay}"
                                                  ToolTip="这一列在表格里的文字颜色（红 / 黄 / 绿）" />

                                        <Button Grid.Column="7" Content="✕" FontSize="16"
                                                Style="{StaticResource IconButton}"
                                                HorizontalAlignment="Left"
                                                ToolTip="删除这一列"
                                                Click="DeleteDataItem" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="5">
            <TextBlock x:Name="MessageText" Text="" Margin="{StaticResource GapTop12}"
                       Foreground="{DynamicResource DangerBrush}"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource GapTop16}">
                <Button Content="取消" Style="{StaticResource SecondaryButton}"
                        Width="100" Height="44" Margin="{StaticResource GapRight12}"
                        IsCancel="True" Click="Cancel" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}"
                        Width="110" Height="44" IsDefault="True" Click="Confirm" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
