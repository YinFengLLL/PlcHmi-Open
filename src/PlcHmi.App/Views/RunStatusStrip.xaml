<UserControl x:Class="上位机.应用.视图.运行状态条"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:上位机.应用.转换器"
             xmlns:charts="clr-namespace:上位机.应用.视图">
    <!--
        主运行页左下角状态条（2026-10-16 现场要求）。

        顺序：通信 → 锁附 → 点胶 → 加工 → 已锁附颗数 → 报警。
        前五个是"一眼结论"，报警放最后并分到更宽的一栏（报警摘要带代码、消息与时间，挤压会读不全）。

        风格与原有通讯状态灯一致：辉光状态灯 + 小字标题 + 粗体结论，单元之间 1px 分隔线。
        三盏工位灯的取值为 0=未完成 / 1=完成，颗数读一个 INT 型地址；
        地址全部由管理员在运行页「编辑地址」里改（点位定义落在 config/tags.json）。

        "通信"来自主窗口 DataContext（窗口级状态），其余来自本页 DataContext——用
        RelativeSource 找 Window 保持与原来同一套绑定，不额外搬运状态。
    -->
    <UserControl.Resources>
        <conv:资源键画刷转换器 x:Key="KeyToBrush" />

        <!-- 单元样式：左侧 1px 分隔线（第一个单元不加，避免与卡片边框叠成双线） -->
        <Style x:Key="状态条单元" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Margin" Value="{StaticResource GapV12}" />
            <Setter Property="Padding" Value="{StaticResource GapH12}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <!-- 报警摘要最宽：它带报警代码、消息与时间，挤窄了只能读到半句 -->
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 通信状态（来自主窗口 DataContext，辉光状态灯） -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <charts:辉光状态灯 Fill="{Binding DataContext.连接状态颜色键, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource KeyToBrush}}"
                                   Margin="{StaticResource GapRight12}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="通信" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding DataContext.连接状态文本, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <!-- 锁附 / 点胶 / 加工完成：0=未完成（灰），1=完成（绿） -->
            <Border Grid.Column="1" Style="{StaticResource 状态条单元}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <charts:辉光状态灯 Fill="{Binding 锁附状态颜色键, Converter={StaticResource KeyToBrush}}"
                                       Margin="{StaticResource GapRight12}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="锁附" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding 锁附状态文本}" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource 状态条单元}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <charts:辉光状态灯 Fill="{Binding 点胶状态颜色键, Converter={StaticResource KeyToBrush}}"
                                       Margin="{StaticResource GapRight12}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="点胶" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding 点胶状态文本}" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource 状态条单元}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <charts:辉光状态灯 Fill="{Binding 加工状态颜色键, Converter={StaticResource KeyToBrush}}"
                                       Margin="{StaticResource GapRight12}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="加工" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding 加工状态文本}" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 已锁附颗数：INT 型地址的读数。不配灯——它是连续量，"亮/灭"表达不了多少颗 -->
            <Border Grid.Column="4" Style="{StaticResource 状态条单元}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="已锁附颗数" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding 已锁附颗数文本}" Style="{StaticResource BodyText}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 报警状态（辉光状态灯）。文字放大加粗：它是首屏第三个"一眼结论"，
                 13px 在工控机 1360 宽屏上偏小（2026-10-16 现场反馈） -->
            <Border Grid.Column="5" Style="{StaticResource 状态条单元}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <charts:辉光状态灯 Fill="{Binding 报警摘要颜色键, Converter={StaticResource KeyToBrush}}"
                                       Margin="{StaticResource GapRight12}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="报警" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding 报警摘要}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
