<UserControl x:Class="PlcHmi.App.Views.DonutRatioChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 环形占比图：随布局实际尺寸原生重绘（旧版按 170×150 设计稿画好再套
             Viewbox 等比放大，全屏下非整数倍缩放会让中心读数发虚）。 -->
        <Grid Grid.Row="0" x:Name="DonutContainer" Margin="0,4,0,0">
            <Path x:Name="Sectionitem" Fill="{DynamicResource SuccessBrush}" />
            <Path x:Name="Sectionitem2" Fill="{DynamicResource DangerBrush}" />

            <!-- 中心读数：总量（字号随环半径缩放，见代码） -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock x:Name="TotalAmountText" Text="0"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center" />
                <TextBlock x:Name="TotalAmountTagText" Text="总产量"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 图例：色点 + 名称 + 数量 + 占比（13px：环形图下方的图例是操作员
             读"良品 / 不良品各多少"的主要途径，11px 在两米外看不清） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,4,0,0">
            <Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding LabelA, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ItemValueText" Text="0 (—)" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="7,0,18,0" VerticalAlignment="Center" />

            <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding LabelB, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="Item2ValueText" Text="0 (—)" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
