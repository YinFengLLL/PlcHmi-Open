<UserControl x:Class="PlcHmi.App.Views.HistoryRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PlcHmi.App.Converters"
             xmlns:vm="clr-namespace:PlcHmi.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HistoryRecordViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BooleanVisibilityConverter x:Key="BoolToVis" />
        <conv:ResourceKeyBrushConverter x:Key="KeyToBrush" />

        <!-- 数据行模板：动态列用 UniformGrid 均分，与表头同一套列宽规则
             （固定列 56/96 在两处必须一致，否则表头会与数据错位） -->
        <DataTemplate x:Key="HistoryRowTemplate" DataType="{x:Type vm:HistoryRecordRowViewModel}">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 工单号（2026-11-12）：写下这条记录时上一次扫码的结果，不落盘 -->
                    <TextBlock Grid.Column="0" Text="{Binding WorkOrderText}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding WorkOrderText}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Grid.Column="1" Text="{Binding IndexText}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextDisabledBrush}" />

                    <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                               FontFamily="{StaticResource NumericFontFamily}"
                               FontSize="13" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <ItemsControl Grid.Column="3" ItemsSource="{Binding ShowValueCollection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 文字颜色来自该列配置的红/黄/绿（管理员在「编辑数据体」里设）；
                                     颜色只做强调，文本本身仍是完整信息 -->
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="{StaticResource NumericFontFamily}"
                                           FontSize="13" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding ColorKey, Converter={StaticResource KeyToBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 表头：列名 + 单位（数据源是核心层的历史数据项模型，故不写 DataType）。
             列名颜色与该列数据一致：配了红/黄/绿的列，表头也跟着变色，长表格里一眼可辨；
             没配颜色的列仍是原来的次要色（观感零变化） -->
        <DataTemplate x:Key="HistoryHeaderCellTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{StaticResource GapV4}">
                <TextBlock Text="{Binding Name}" TextAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding HeaderColorKey, Converter={StaticResource KeyToBrush}}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Address}" />
                <TextBlock Text="{Binding Unit}" TextAlignment="Center"
                           FontSize="11" Margin="{StaticResource GapTop4}"
                           Foreground="{DynamicResource TextDisabledBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}"
          Style="{DynamicResource PageTransitionStyle}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <!-- 工具条：按天翻页 + 导出 / 配置 / 清除 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                Padding="{StaticResource ToolBarPadding}" Margin="{StaticResource GapBottom12}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹ 前一天" Style="{StaticResource SecondaryButton}"
                            Height="44" Width="110" Margin="{StaticResource GapRight8}"
                            ToolTip="翻到最近有记录的前一天"
                            Command="{Binding BeforeOneDaysAsyncCommand}" />

                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8"
                            Height="44" MinWidth="220" Margin="{StaticResource GapRight8}">
                        <TextBlock Text="{Binding DateText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Margin="{StaticResource GapV12}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>

                    <Button Content="后一天 ›" Style="{StaticResource SecondaryButton}"
                            Height="44" Width="110" Margin="{StaticResource GapRight8}"
                            ToolTip="翻到最近有记录的后一天"
                            Command="{Binding AfterOneDaysAsyncCommand}" />

                    <Button Content="回到今天" Style="{StaticResource SecondaryButton}"
                            Height="44" Margin="{StaticResource GapRight8}"
                            Command="{Binding BackToTodayAsyncCommand}" />

                    <TextBlock Text="{Binding RecordCountText}" VerticalAlignment="Center"
                               Margin="{StaticResource GapLeft12}"
                               Style="{StaticResource CaptionText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="导出 CSV" Style="{StaticResource SecondaryButton}"
                            Height="44" Margin="{StaticResource GapRight8}"
                            ToolTip="把当前这一天的记录导出为 CSV（Excel 可直接打开）"
                            Command="{Binding ExportCsvAsyncCommand}" />

                    <Button Content="编辑数据体" Style="{StaticResource SecondaryButton}"
                            Height="44" Margin="{StaticResource GapRight8}"
                            Visibility="{Binding EditableHistory, Converter={StaticResource BoolToVis}}"
                            ToolTip="修改触发位与数据项（地址 / 类型 / 小数位 / ASCII 显示 / 列颜色），仅管理员"
                            Command="{Binding EditConfigAsyncCommand}" />

                    <!-- 不可恢复操作：独立危险样式，与普通按钮拉开间距，避免误点 -->
                    <Button Content="清除历史" Style="{StaticResource DangerousActionButton}"
                            Height="44" Margin="{StaticResource GapLeft16}"
                            Visibility="{Binding EditableHistory, Converter={StaticResource BoolToVis}}"
                            ToolTip="清除全部历史记录（仅管理员）"
                            Command="{Binding ClearRemoveHistoryAsyncCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 采集状态：状态灯必配文字，颜色不单独承载信息 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="{StaticResource NoticePadding}"
                Margin="{StaticResource GapBottom12}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}"
                         Fill="{Binding SamplingStateColorKey, Converter={StaticResource KeyToBrush}}" />
                <TextBlock Text="{Binding DataBodyName}" Style="{StaticResource BodyText}"
                           FontWeight="SemiBold" Margin="{StaticResource GapLeft8}" />
                <TextBlock Text="{Binding SamplingStateText}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="{StaticResource GapLeft12}" />
            </StackPanel>
        </Border>

        <!-- 表格 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="{StaticResource GapBottom8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="历史明细" Style="{StaticResource SectionTitleText}"
                               Margin="{StaticResource CardPadding}" />
                    <TextBlock Grid.Column="1" Text="最新的在最上面 · 可上下滑动查看当日数据"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Margin="{StaticResource CardPadding}" />
                </Grid>

                <!-- 表头与数据行放在同一个滚动区（横向滚动时表头一起移动，列永远对齐）；
                     PanningMode=Both：触摸屏上既可下滑看当日数据，也可横滑看更多列。 -->
                <ScrollViewer PanningMode="Both"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel MinWidth="{Binding TableWidth}">
                        <!-- 表头 -->
                        <Border Background="{DynamicResource PrimarySoftBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="工单号" Style="{StaticResource CaptionText}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           ToolTip="上一次扫码的结果（只在本机内存中，关软件即清空）" />
                                <TextBlock Grid.Column="1" Text="序号" Style="{StaticResource CaptionText}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="时间" Style="{StaticResource CaptionText}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <ItemsControl Grid.Column="3" ItemsSource="{Binding ColumnCollection}"
                                              ItemTemplate="{StaticResource HistoryHeaderCellTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- 数据行 -->
                        <Grid>
                            <ItemsControl ItemsSource="{Binding RecordCollection}"
                                          ItemTemplate="{StaticResource HistoryRowTemplate}" />

                            <!-- 空状态：当天没有记录是常态（休息日 / 未开机），要明确回答"就是没有" -->
                            <StackPanel HorizontalAlignment="Center" Margin="{StaticResource GapTop60}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecordCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Style="{StaticResource IconPathLarge}"
                                      Data="{StaticResource Icon.Nav.History}"
                                      Stroke="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Text="这一天没有记录" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="{StaticResource GapTop8}" />
                                <TextBlock Text="可用「前一天 / 后一天」翻到有记录的日期"
                                           Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="{StaticResource GapTop4}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
