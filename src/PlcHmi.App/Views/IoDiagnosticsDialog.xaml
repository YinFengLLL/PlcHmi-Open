<Window x:Class="上位机.应用.视图.IO诊断对话框"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IO 通信诊断"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <!--
        IO 通信诊断：把 X / Y 段在 FC01（线圈）与 FC02（离散输入）上的原始读数并排摆出来。
        用途——"IO 显示与物理对不上"时，一眼看出物理 IO 落在哪个功能码上，
        再据此配置 io-points.json 元的 X区域 / Y区域。
    -->
    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom12}">
            <TextBlock Text="IO 通信诊断" Style="{StaticResource DialogTitleText}" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop8}" TextWrapping="Wrap"
                       Text="下面是把 X / Y 两个地址段分别用 FC01（线圈）和 FC02（离散输入）读到的原始位。物理输入/输出只会落在其中一个功能码上——哪一行有 1 且随现场动作变化，那一行就是对的。" />
        </StackPanel>

        <DataGrid x:Name="读数表格" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="ColumnHeader"
                  GridLinesVisibility="Horizontal"
                  FontSize="13"
                  Background="Transparent"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="区 / 功能码" Binding="{Binding 标题}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="起始地址" Binding="{Binding 地址}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="读到的位（高位在左）" Binding="{Binding 位串}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="结果" Binding="{Binding 结果文本}" Width="110" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="{StaticResource ChipPadding}"
                Margin="{StaticResource GapTop12}">
            <StackPanel>
                <TextBlock Text="结论与下一步" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="结论文本" Margin="{StaticResource GapTop4}" TextWrapping="Wrap"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource GapTop12}">
            <Button Content="重新诊断" Style="{StaticResource SecondaryButton}"
                    Width="120" Height="40" Margin="{StaticResource GapRight8}"
                    Click="重新诊断" />
            <Button Content="关闭" Style="{StaticResource PrimaryButton}"
                    Width="120" Height="40"
                    Click="关闭" />
        </StackPanel>
    </Grid>
</Window>
