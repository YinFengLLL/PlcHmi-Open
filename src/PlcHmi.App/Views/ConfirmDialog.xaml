<Window x:Class="PlcHmi.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作确认"
        Width="480" SizeToContent="Height"
        MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题：分级图标 + 标题文字。危险等级由代码后置着色
             （Neutral=主蓝 / Warning=警示橙 / Danger=危险红），操作员一眼分清操作等级 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource GapBottom16}">
            <Border x:Name="IconFrame" Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource WarningSoftBrush}"
                    VerticalAlignment="Center" Margin="{StaticResource GapRight12}">
                <Path Style="{StaticResource IconPathLarge}"
                      Data="{StaticResource Icon.Status.Alarm}"
                      x:Name="IconWordShape"
                      Stroke="{DynamicResource WarningStrongBrush}" />
            </Border>
            <TextBlock x:Name="TitleBarText" Text="操作确认"
                       Style="{StaticResource DialogTitleText}" />
        </StackPanel>

        <!-- 后果描述：写"会发生什么"，不复述按钮名 -->
        <TextBlock x:Name="MessageText" Grid.Row="1"
                   Text="确认执行该操作？"
                   FontSize="15" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <!-- 补充说明（可选）：影响范围 / 撤销方式 -->
        <TextBlock x:Name="DetailText" Grid.Row="2"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Style="{StaticResource CaptionText}"
                   Margin="{StaticResource GapTop8}" />

        <!-- 按钮区：默认焦点在「取消」——回车 = 取消，
             执行必须显式点击，杜绝惯性回车误触（工业 HMI 防误触铁律） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="{StaticResource GapTop20}">
            <Button x:Name="CancelButton" Content="取消"
                    Style="{StaticResource SecondaryButton}"
                    Width="104" IsCancel="True"
                    Margin="{StaticResource GapRight12}" />
            <Button x:Name="ConfirmButton" Content="确认执行"
                    Style="{StaticResource ButtonWarning}"
                    Width="132" Click="Confirm" />
        </StackPanel>
    </Grid>
</Window>
