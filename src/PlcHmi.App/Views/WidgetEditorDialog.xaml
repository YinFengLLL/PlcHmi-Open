<Window x:Class="PlcHmi.App.Views.ComponentEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑手动页元件"
        Height="520" Width="470"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Text="元件配置" Style="{StaticResource DialogTitleText}" />
            <TextBlock Text="元件绑定的是内部继电器（M 区），由 PLC 程序决定何时驱动实际输出"
                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop8}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 类型 -->
        <StackPanel Grid.Row="1" Margin="{StaticResource GapBottom12}">
            <TextBlock Text="元件类型" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <ComboBox x:Name="TypeFrame" Height="44" VerticalContentAlignment="Center"
                      SelectionChanged="TypeChanged" />
        </StackPanel>

        <!-- 名称 -->
        <StackPanel Grid.Row="2" Margin="{StaticResource GapBottom12}">
            <TextBlock Text="显示名称" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <TextBox x:Name="NameFrame" Style="{StaticResource InputBox}" MaxLength="20" />
        </StackPanel>

        <!-- 控制地址（气缸 / 按钮） -->
        <StackPanel x:Name="ExtendFaceBoard" Grid.Row="3" Margin="{StaticResource GapBottom12}">
            <TextBlock x:Name="ExtendTag" Text="控制地址（M 区）"
                       Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExtendFrame" Grid.Column="0" Style="{StaticResource InputBox}"
                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="12"
                         TextChanged="AddressManuallyModified" />
                <Button x:Name="扩展选变量按钮" Grid.Column="2" Content="选变量…"
                        Style="{StaticResource SecondaryButton}" Height="44"
                        Click="ExtendAddressSelectVariable" />
            </Grid>
            <TextBlock x:Name="ExtendHint" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                       Margin="{StaticResource GapTop4}" />
        </StackPanel>

        <!-- 监测地址 -->
        <StackPanel x:Name="StateFaceBoard" Grid.Row="4" Margin="{StaticResource GapBottom12}">
            <TextBlock Text="监测地址（M 区）" Style="{StaticResource BodyText}" Margin="{StaticResource GapBottom8}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StateFrame" Grid.Column="0" Style="{StaticResource InputBox}"
                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="12"
                         TextChanged="StateAddressManuallyModified" />
                <Button x:Name="状态选变量按钮" Grid.Column="2" Content="选变量…"
                        Style="{StaticResource SecondaryButton}" Height="44"
                        Click="StateAddressSelectVariable" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="MessageText" Grid.Row="6" VerticalAlignment="Top"
                   Text="" Foreground="{DynamicResource DangerBrush}"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="100" Height="44" Margin="{StaticResource GapRight12}" IsCancel="True" Click="Cancel" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}"
                    Width="110" Height="44" IsDefault="True" Click="Confirm" />
        </StackPanel>
    </Grid>
</Window>
