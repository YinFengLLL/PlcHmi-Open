<Window x:Class="PlcHmi.App.Views.RunMonitorAddressEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑运行监控页元件地址"
        Height="640" Width="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid Margin="{StaticResource DialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource GapBottom12}">
            <TextBlock Text="运行监控页元件地址" Style="{StaticResource DialogTitleText}" />
            <TextBlock Text="监控量绑定 D 区寄存器，操作按钮绑定 M 区内部继电器；保存后立即重建采集计划，无需重启程序"
                       Style="{StaticResource CaptionText}" Margin="{StaticResource GapTop8}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 元件地址一览（监控量 6 项 + 命令 5 项） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ComponentListWidget">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="6" Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="{StaticResource GapTop4}"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding TagName, Mode=OneWay}" />
                                        <Run Text=" · 默认 " />
                                        <Run Text="{Binding DefaultAddress, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Remark, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <TextBox Grid.Column="2" Style="{StaticResource InputBox}"
                                         VerticalContentAlignment="Center"
                                         FontFamily="{StaticResource NumericFontFamily}" MaxLength="12"
                                         Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="MessageText" Grid.Row="2" Text=""
                   Foreground="{DynamicResource DangerBrush}"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="{StaticResource GapBottom8}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Width="100" Height="44" Margin="{StaticResource GapRight12}"
                    IsCancel="True" Click="Cancel" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}"
                    Width="110" Height="44" IsDefault="True" Click="Confirm" />
        </StackPanel>
    </Grid>
</Window>
