<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         深色主题 · 调色板「深空蓝」（默认主题）
         深蓝黑基底 + 科技蓝主色 + 科技青点缀：主控室 / 车间暗环境
         长时间监控护目，状态灯与数据在深色底上"自发光"。

         键集合与 Palette.Light.xaml 严格一一对应。
         全部文本组合实测对比度见 tools/check_contrast.py（双主题各一组）。

         深色主题的分工与浅色不同，改值前先读懂这两条：
         · PrimaryBrush（#1D5FD6）只做"填充"——按钮底、顶栏底、选中底，
           白字压其上 ≥4.5:1；它**不**用作深色底上的文字色。
         · PrimaryLightBrush（#6EA8FF）才是深色底上的主色文字/描边
           （链接、次按钮文字、导航图标），压 Surface ≥7:1。
         ════════════════════════════════════════════════════════════════ -->

    <!-- ── 主色：科技蓝 ───────────────────────────────────────────── -->
    <Color x:Key="PrimaryColor">#1D5FD6</Color>
    <Color x:Key="PrimaryDarkColor">#174CA8</Color>
    <Color x:Key="PrimaryLightColor">#6EA8FF</Color>
    <Color x:Key="PrimarySoftColor">#16263F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />

    <!-- ── 点缀色：科技青（数据高亮 / 运行中状态点缀，克制使用）───── -->
    <Color x:Key="AccentColor">#00E5C7</Color>
    <Color x:Key="AccentSoftColor">#0F2E2A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <!-- ── 背景层次：深蓝黑，非纯黑（纯黑与高亮文字对比过强反而刺眼）── -->
    <Color x:Key="BackgroundColor">#0B1220</Color>
    <Color x:Key="SurfaceColor">#131C2E</Color>
    <Color x:Key="SurfaceAltColor">#18243A</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <!-- ── 文本 ───────────────────────────────────────────────────── -->
    <Color x:Key="TextPrimaryColor">#E8EEF8</Color>
    <Color x:Key="TextSecondaryColor">#93A3BC</Color>
    <Color x:Key="TextDisabledColor">#5E6E88</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <!-- ── 边框 ───────────────────────────────────────────────────── -->
    <Color x:Key="BorderColor">#26314A</Color>
    <Color x:Key="BorderStrongColor">#5C6D94</Color>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <!-- ── 状态色：深色底上比浅色主题略提亮，填充态白字 ≥4.5:1 ────── -->
    <Color x:Key="SuccessColor">#178543</Color>
    <Color x:Key="SuccessSoftColor">#12291B</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />

    <Color x:Key="DangerColor">#D32F2F</Color>
    <Color x:Key="DangerSoftColor">#2E1518</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

    <Color x:Key="WarningColor">#F5A623</Color>
    <Color x:Key="WarningStrongColor">#A86608</Color>
    <Color x:Key="WarningSoftColor">#31250F</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningStrongBrush" Color="{StaticResource WarningStrongColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />

    <Color x:Key="MutedColor">#8A95A5</Color>
    <Color x:Key="OffColor">#2E3A52</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="OffBrush" Color="{StaticResource OffColor}" />

    <!-- ── 主色底(顶栏)专用：半透明白族，两主题通用（Primary 均为彩色填充）── -->
    <SolidColorBrush x:Key="OnPrimaryGhostBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="OnPrimarySubtleBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="OnPrimaryDividerBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="OnPrimaryEdgeBrush" Color="#44FFFFFF" />
    <SolidColorBrush x:Key="OnPrimaryFadedTextBrush" Color="#CCFFFFFF" />

    <!-- 主色底上的次要文字：深色主题 Primary 更亮，此处同步调亮保 ≥4.5:1 -->
    <Color x:Key="OnPrimaryMutedColor">#D8E6FA</Color>
    <SolidColorBrush x:Key="OnPrimaryMutedBrush" Color="{StaticResource OnPrimaryMutedColor}" />

    <!-- ══ 深色底（主蓝顶栏 / Hero 卡）上的文字与交互 ═════════════════
         深色主题的 Primary（#1D5FD6）比浅色的 #0B3D91 亮一档，
         压其上的文字整体调亮；分工门槛不变：正文/次要 ≥4.5:1，
         装饰线与强调 ≥3:1（只作图形，不可写小字正文）。 -->
    <Color x:Key="OnShellPrimaryColor">#F2F7FF</Color>
    <Color x:Key="OnShellSecondaryColor">#D8E6FA</Color>
    <Color x:Key="OnShellMutedColor">#A9BEDE</Color>
    <Color x:Key="OnShellAccentColor">#8FC3FF</Color>

    <SolidColorBrush x:Key="OnShellPrimaryBrush" Color="{StaticResource OnShellPrimaryColor}" />
    <SolidColorBrush x:Key="OnShellSecondaryBrush" Color="{StaticResource OnShellSecondaryColor}" />
    <SolidColorBrush x:Key="OnShellMutedBrush" Color="{StaticResource OnShellMutedColor}" />
    <SolidColorBrush x:Key="OnShellAccentBrush" Color="{StaticResource OnShellAccentColor}" />

    <SolidColorBrush x:Key="OnShellDividerBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="OnShellHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="OnShellActiveBrush" Color="#26FFFFFF" />

    <!-- ── 键盘焦点环：深色底上用 PrimaryLight，任何底色可见 ── -->
    <Color x:Key="FocusRingColor">#6EA8FF</Color>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />

    <!-- ── 阴影：只给弹出层。深色底上阴影几乎不可见（分层靠描边），
         保留仅为避免弹出层与页面内容"糊"在一起。 -->
    <DropShadowEffect x:Key="Elevation1" BlurRadius="6" ShadowDepth="1" Opacity="0.30" Color="#000000" Direction="270" />
    <DropShadowEffect x:Key="Elevation2" BlurRadius="12" ShadowDepth="2" Opacity="0.40" Color="#000000" Direction="270" />
    <DropShadowEffect x:Key="Elevation3" BlurRadius="24" ShadowDepth="6" Opacity="0.50" Color="#000000" Direction="270" />

    <!-- ── 交互罩层：深色底"加深"等于没反应，改为"加亮"半透明白 ── -->
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#26FFFFFF" />

</ResourceDictionary>
